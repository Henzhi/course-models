  "steps": [
    {
      "name": "第 23 对染色体不一样",
      "say": "人的体细胞里有 23 对染色体，前 22 对男女都一样，只有第 23 对不一样。",
      "stats": [
        {
          "v": "22 对",
          "label": "常染色体（男女相同）"
        },
        {
          "v": "1 对",
          "label": "性染色体（XX 或 XY）"
        }
      ],
      "ask": "看左上的母亲和左下的父亲，第 23 对染色体差在哪？",
      "note": "女性的性染色体是 <b>XX</b>（两条一样长），男性是 <b>XY</b>（一条长、一条短）。<b>长短不同，就是 X 和 Y 的区别</b>。",
      "parts": [
        "sexchrom",
        "momcell",
        "dadcell"
      ],
      "routes": [],
      "caption": "长棒 = X 染色体，短棒 = Y 染色体"
    },
    {
      "name": "母亲只给 X",
      "say": "母亲是 XX，形成卵细胞时两条 X 分开，所以每个卵细胞都含一条 X。",
      "stats": [
        {
          "v": "1 种",
          "label": "卵细胞（只含 X）"
        }
      ],
      "ask": "卵细胞里有可能出现 Y 吗？为什么？",
      "note": "母亲身上没有 Y，所以<b>卵细胞只有一种：必含 X</b>。这一点已经决定了——<b>生男生女不可能由母亲决定</b>。",
      "parts": [
        "momcell",
        "egg",
        "sexchrom"
      ],
      "routes": [
        "r_mom"
      ],
      "caption": "卵细胞：只含 X，只有一种"
    },
    {
      "name": "父亲给 X 或 Y",
      "say": "父亲是 XY，两条性染色体分开时，含 X 的精子和含 Y 的精子各占一半。",
      "stats": [
        {
          "v": "2 种",
          "label": "精子（含 X / 含 Y，各半）"
        }
      ],
      "ask": "为什么父亲的精子有两种，而母亲的卵细胞只有一种？",
      "note": "<b>精子有两种：含 X 的和含 Y 的</b>，数量大致各占一半。这是子代性别不同的<b>唯一来源</b>。",
      "parts": [
        "dadcell",
        "spermX",
        "spermY",
        "sexchrom"
      ],
      "routes": [
        "r_dadX",
        "r_dadY"
      ],
      "caption": "精子：含 X 或含 Y，各占一半"
    },
    {
      "name": "给 X 就是女孩",
      "say": "含 X 的精子与卵细胞结合，受精卵里是两条 X——一样长。",
      "stats": [
        {
          "v": "XX",
          "label": "女孩"
        }
      ],
      "ask": "这个受精卵里的两条 X，分别来自谁？",
      "note": "卵细胞给的是 X，含 X 的精子给的也是 X，所以是 <b>XX</b>。<b>两条一样长</b>，发育成女孩。",
      "parts": [
        "egg",
        "spermX",
        "zygoteXX",
        "sexchrom"
      ],
      "routes": [
        "r_egg1",
        "r_spermX"
      ],
      "caption": "X 精子 + X 卵细胞 → XX（女孩）"
    },
    {
      "name": "给 Y 就是男孩",
      "say": "含 Y 的精子与卵细胞结合，受精卵里是一长一短——XY。",
      "stats": [
        {
          "v": "XY",
          "label": "男孩"
        }
      ],
      "ask": "这条 Y 一定来自谁？有没有可能来自母亲？",
      "note": "卵细胞只含 X，所以 <b>Y 一定来自父亲</b>。这就是「生男生女由父亲决定」最直接的证据——<b>母亲这一侧根本没有变量</b>。",
      "parts": [
        "egg",
        "spermY",
        "zygoteXY",
        "sexchrom"
      ],
      "routes": [
        "r_egg2",
        "r_spermY"
      ],
      "caption": "Y 精子 + X 卵细胞 → XY（男孩）"
    },
    {
      "name": "所以，各占一半",
      "say": "含 X 的精子与卵细胞结合，受精卵是 XX；含 Y 的结合，就是 XY。",
      "stats": [
        {
          "v": "XX",
          "label": "女孩"
        },
        {
          "v": "XY",
          "label": "男孩"
        }
      ],
      "ask": "两个受精卵里，哪一条是母亲给的？哪一条是父亲给的？",
      "note": "不管哪种结果，<b>卵细胞给的都是 X</b>。差别只在父亲给的是 X 还是 Y——<b>给 X 是女孩，给 Y 是男孩</b>。",
      "parts": [
        "egg",
        "spermX",
        "spermY",
        "zygoteXX",
        "zygoteXY",
        "sexchrom"
      ],
      "routes": [],
      "caption": "性别取决于父亲的精子，机会各半"
    }
  ],

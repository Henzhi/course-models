  "parts": [
    {
      "id": "sexchrom",
      "name": "性染色体",
      "en": "sex chromosome",
      "only": "第 23 对",
      "desc": "决定性别的一对染色体。女性是 XX（两条等长），男性是 XY（一条长、一条短）。",
      "role": "长的是 X，短的是 Y——看长短就能分辨，不用记别的。",
      "warn": "第 23 对以外的 22 对叫常染色体，男女完全相同，与性别无关。"
    },
    {
      "id": "momcell",
      "name": "母亲体细胞",
      "en": "somatic cell",
      "only": "XX",
      "desc": "含 23 对染色体，第 23 对是两条一样的 X。",
      "role": "形成卵细胞时只交出其中一条 X。",
      "warn": "母亲身上没有 Y，所以她的卵细胞不可能带 Y。"
    },
    {
      "id": "dadcell",
      "name": "父亲体细胞",
      "en": "somatic cell",
      "only": "XY",
      "desc": "含 23 对染色体，第 23 对是一条 X、一条 Y。",
      "role": "形成精子时 X 和 Y 分开，各进入一半的精子。",
      "warn": "「生男生女由母亲决定」是错的——母亲只能给 X，变量在父亲这边。"
    },
    {
      "id": "egg",
      "name": "卵细胞",
      "en": "ovum",
      "only": "含 X",
      "desc": "染色体数减半，第 23 条一定是 X。",
      "role": "与含 X 或含 Y 的精子结合，决定受精卵的性别组合。",
      "warn": "卵细胞只有一种，不存在「含 Y 的卵细胞」。"
    },
    {
      "id": "spermX",
      "name": "含 X 的精子",
      "en": "sperm",
      "only": "含 X",
      "desc": "染色体数减半，第 23 条是 X。与卵细胞结合后是 XX。",
      "role": "受精后发育成女孩。",
      "warn": "含 X 的精子本身不「决定女孩」——是它与卵细胞组合的结果。"
    },
    {
      "id": "spermY",
      "name": "含 Y 的精子",
      "en": "sperm",
      "only": "含 Y",
      "desc": "染色体数减半，第 23 条是 Y。与卵细胞结合后是 XY。",
      "role": "受精后发育成男孩。",
      "warn": "两种精子数量大致各半，所以男女比例接近 1:1。"
    },
    {
      "id": "zygoteXX",
      "name": "受精卵 XX",
      "en": "zygote",
      "only": "女孩",
      "desc": "两条 X，一条来自母亲、一条来自父亲。",
      "role": "发育成女孩。",
      "warn": "两条 X 一样长，所以画成两根等长的棒。"
    },
    {
      "id": "zygoteXY",
      "name": "受精卵 XY",
      "en": "zygote",
      "only": "男孩",
      "desc": "一条 X 来自母亲、一条 Y 来自父亲。",
      "role": "发育成男孩。",
      "warn": "Y 一定来自父亲——这是判断「生男生女谁决定」的关键证据。"
    }
  ]

  "hero": {
    "title": "细菌 · 真菌 · 病毒",
    "goal": "细菌没有成形的细胞核，真菌有细胞核，病毒连细胞结构都没有——这三句话是这一节的全部考点。",
    "tips": [
      "三栏并排看，先找它们的细胞壁在哪",
      "点「细胞核的有无」，这是最容易混的地方",
      "点「病毒没有细胞结构」，看病毒到底剩下了什么"
    ]
  },
  "groups": [
    {
      "label": "细胞壁·细胞膜",
      "title": "都有细胞壁和细胞膜",
      "lead": "细菌和真菌都是细胞，都有细胞壁、细胞膜、细胞质。",
      "items": "细菌的细胞壁 · 细菌的细胞膜 · 真菌的细胞壁 · 真菌的细胞膜",
      "tip": "病毒没有细胞壁，也没有细胞膜——它没有细胞结构。",
      "ids": [
        "bwall",
        "bmem",
        "fwall",
        "fmem"
      ]
    },
    {
      "label": "细胞核的有无",
      "title": "细菌没有成形的细胞核",
      "lead": "细菌的 DNA 集中在细胞里的一个区域，外面<b>没有核膜</b>包着；真菌的 DNA 在<b>成形的细胞核</b>里。",
      "items": "细菌的 DNA（拟核）· 真菌的细胞核",
      "tip": "一句话：细菌无核，真菌有核。这是区分两者的第一依据。",
      "ids": [
        "bdna",
        "fnucleus"
      ]
    },
    {
      "label": "病毒没有细胞结构",
      "title": "病毒只剩两样东西",
      "lead": "病毒只有<b>蛋白质外壳</b>和内部的<b>遗传物质</b>，没有细胞壁、细胞膜、细胞质。",
      "items": "蛋白质外壳 · 遗传物质",
      "tip": "病毒不能独立生活，必须寄生在活细胞里才能繁殖。",
      "ids": [
        "capsid",
        "genome"
      ]
    }
  ],
  "parts": [
    {
      "id": "bcapsule",
      "name": "荚膜",
      "en": "capsule",
      "only": "部分细菌有",
      "desc": "有些细菌最外面还有一层黏液状的荚膜。",
      "role": "保护细菌，抵抗宿主细胞的吞噬。",
      "warn": "荚膜不是所有细菌都有，鞭毛也一样——别把「部分细菌有」当成「细菌都有」。"
    },
    {
      "id": "bwall",
      "name": "细菌的细胞壁",
      "en": "cell wall",
      "only": "细菌",
      "desc": "细菌荚膜内侧的一层壁，成分和植物细胞壁不同。",
      "role": "保护细菌、维持细胞形状。",
      "warn": "细菌有细胞壁，但没有成形的细胞核——「有壁」和「有核」是两件独立的事。"
    },
    {
      "id": "bmem",
      "name": "细菌的细胞膜",
      "en": "cell membrane",
      "only": "细菌",
      "desc": "紧贴细胞壁内侧的一层膜。",
      "role": "控制物质进出。",
      "warn": "细胞膜的功能在细菌、真菌、植物、动物身上都一样：控制物质进出。"
    },
    {
      "id": "bcyto",
      "name": "细菌的细胞质",
      "en": "cytoplasm",
      "only": "细菌",
      "desc": "细胞膜以内的部分。",
      "role": "各种代谢活动在这里进行。",
      "warn": "细菌没有线粒体、叶绿体这些细胞器。初中阶段记住「没有成形的细胞核」就够了。"
    },
    {
      "id": "bdna",
      "name": "DNA（拟核）",
      "en": "nucleoid",
      "only": "细菌",
      "desc": "细菌的遗传物质，集中在细胞内的一个区域，但外面<b>没有核膜</b>包着。",
      "role": "控制细菌的生命活动。",
      "warn": "这是细菌和真菌最关键的区别：细菌没有成形的细胞核，只有 DNA 集中的区域。"
    },
    {
      "id": "bflag",
      "name": "鞭毛",
      "en": "flagellum",
      "only": "部分细菌有",
      "desc": "有些细菌末端长有细长弯曲的鞭毛。",
      "role": "运动。",
      "warn": "鞭毛和荚膜一样，不是所有细菌都有。"
    },
    {
      "id": "fwall",
      "name": "真菌的细胞壁",
      "en": "cell wall",
      "only": "真菌",
      "desc": "酵母菌最外层的一层壁。",
      "role": "保护、维持形状。",
      "warn": "真菌既有细胞壁，又有细胞核——这两点是同时成立的。"
    },
    {
      "id": "fmem",
      "name": "真菌的细胞膜",
      "en": "cell membrane",
      "only": "真菌",
      "desc": "紧贴细胞壁内侧的一层膜。",
      "role": "控制物质进出。",
      "warn": "真菌是真核生物，细胞膜、细胞质、细胞核一样都不少。"
    },
    {
      "id": "fnucleus",
      "name": "真菌的细胞核",
      "en": "nucleus",
      "only": "真菌",
      "desc": "真菌细胞里有<b>成形的细胞核</b>，外面有核膜包着。",
      "role": "含遗传物质 DNA，控制生命活动。",
      "warn": "「有成形的细胞核」是真菌和细菌最根本的区别——考试基本就考这一句。"
    },
    {
      "id": "fvacuole",
      "name": "液泡",
      "en": "vacuole",
      "only": "真菌",
      "desc": "真菌细胞里的泡状结构。",
      "role": "储存物质。",
      "warn": "真菌有液泡，细菌没有明显的液泡。"
    },
    {
      "id": "fbud",
      "name": "芽体",
      "en": "bud",
      "only": "酵母菌",
      "desc": "酵母菌进行出芽生殖时，母体上长出的一个小突起。",
      "role": "芽体长大后脱离母体，成为一个新的酵母菌。",
      "warn": "出芽生殖不是分裂生殖——是母体上「长出一个小的」，不是「一分为二」。"
    },
    {
      "id": "capsid",
      "name": "蛋白质外壳",
      "en": "capsid",
      "only": "病毒",
      "desc": "病毒最外面的一层蛋白质外壳。",
      "role": "保护内部的遗传物质。",
      "warn": "病毒只有这两样：蛋白质外壳 + 遗传物质。没有细胞壁、细胞膜、细胞质。"
    },
    {
      "id": "genome",
      "name": "遗传物质",
      "en": "genome",
      "only": "病毒",
      "desc": "病毒内部的遗传物质（DNA 或 RNA）。",
      "role": "决定病毒的种类和性状；进入活细胞后，利用宿主细胞的物质复制自己。",
      "warn": "病毒没有细胞结构，不能独立生活，只能寄生在活细胞里。"
    }
  ],

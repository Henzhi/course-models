  "steps": [
    {
      "name": "五个环节，一条路",
      "say": "反射要经过一条固定的路，叫<b>反射弧</b>：感受器 → 传入神经 → 神经中枢 → 传出神经 → 效应器。缺一段，反射就不成立。",
      "stats": [
        {
          "v": "5 段",
          "label": "反射弧"
        },
        {
          "v": "1 个方向",
          "label": "冲动只往前"
        },
        {
          "v": "缺一不可",
          "label": "断哪段都不行"
        }
      ],
      "ask": "先记住方向：<b>感受器收、传入神经送进去、中枢处理、传出神经送出来、效应器做动作</b>。跟着紫色小球走一遍整条路。",
      "note": "反射弧是「<b>一条单向的路</b>」。冲动不能从效应器倒着传回感受器——所以刺激肌肉不会让你「感觉到疼」。",
      "parts": [
        "receptor",
        "afferent",
        "center",
        "efferent",
        "effector"
      ],
      "routes": [
        "afferent",
        "synapse",
        "efferent",
        "response"
      ],
      "caption": "感受器 → 传入神经 → 神经中枢 → 传出神经 → 效应器"
    },
    {
      "name": "起点：感受器",
      "say": "手指碰到烫的东西，皮肤里的<b>神经末梢</b>先被刺激，把「烫」变成<b>神经冲动</b>。",
      "stats": [
        {
          "v": "皮肤",
          "label": "感受器在哪"
        },
        {
          "v": "转换成冲动",
          "label": "它做什么"
        },
        {
          "v": "往里传",
          "label": "下一步"
        }
      ],
      "ask": "注意感受器不是「手」，而是皮肤里极细的神经末梢。它只负责「<b>接收并转换</b>」，不负责做动作。",
      "note": "刺激 → 感受器 → 神经冲动。<b>感受器是反射的起点</b>，没有它就没有后面的任何一步。",
      "parts": [
        "receptor",
        "afferent"
      ],
      "routes": [
        "stimulus",
        "afferent"
      ],
      "caption": "刺激作用于感受器，产生神经冲动"
    },
    {
      "name": "中枢：脊髓里换一次手",
      "say": "冲动沿<b>传入神经</b>进入脊髓的<b>灰质</b>，在这里从一个神经元传给另一个神经元，再决定「让手缩回来」。",
      "stats": [
        {
          "v": "脊髓灰质",
          "label": "缩手反射的中枢"
        },
        {
          "v": "突触",
          "label": "换手的地方"
        },
        {
          "v": "不需要",
          "label": "大脑参与"
        }
      ],
      "ask": "看灰质里那段紫色的传递：冲动在这里「换了一次神经元」。这就是突触——一个神经元的末梢把信息交给下一个。",
      "note": "缩手反射的中枢在<b>脊髓</b>，所以<b>不需要大脑</b>就能完成。这是下面「先缩手后觉疼」的关键。",
      "parts": [
        "center",
        "afferent"
      ],
      "routes": [
        "afferent",
        "synapse"
      ],
      "caption": "神经中枢（脊髓灰质）接收冲动并发出指令"
    },
    {
      "name": "终点：效应器做动作",
      "say": "指令沿<b>传出神经</b>到达<b>效应器</b>——手臂上的肌肉收缩，手就缩回来了。",
      "stats": [
        {
          "v": "传出神经",
          "label": "往外传"
        },
        {
          "v": "肌肉收缩",
          "label": "做的动作"
        },
        {
          "v": "效应器 = 末梢 + 肌肉",
          "label": "它是什么"
        }
      ],
      "ask": "对比一下：传入神经把冲动<b>送进去</b>，传出神经把指令<b>送出来</b>。名字里的「传」字方向相反，别记混。",
      "note": "反射弧的<b>终点是效应器</b>（神经末梢 + 肌肉或腺体），不是「传出神经的末梢」——少了肌肉就不成效应器。",
      "parts": [
        "efferent",
        "effector"
      ],
      "routes": [
        "efferent",
        "response"
      ],
      "caption": "传出神经 → 效应器（肌肉收缩）→ 手缩回"
    },
    {
      "name": "为什么先缩手、后觉疼",
      "say": "缩手这条路只到<b>脊髓</b>就返回了；而「疼」要沿另一条更长的路上行到<b>大脑皮层</b>才能形成痛觉。路长的，到得晚。",
      "stats": [
        {
          "v": "脊髓",
          "label": "缩手的中枢"
        },
        {
          "v": "大脑皮层",
          "label": "痛觉的形成处"
        },
        {
          "v": "更短",
          "label": "缩手那条路"
        }
      ],
      "ask": "看两条路：一条到脊髓就折返（短），一条继续往上到大脑（长）。所以手已经缩回来了，你才反应过来「好烫」。",
      "note": "这个现象有两个常考结论：① 缩手反射<b>不需要大脑</b>；② <b>痛觉在大脑皮层形成</b>，不在手上、也不在脊髓里。",
      "parts": [
        "receptor",
        "afferent",
        "center",
        "efferent",
        "effector",
        "brain"
      ],
      "routes": [
        "afferent",
        "synapse",
        "efferent",
        "response",
        "toBrain"
      ],
      "caption": "缩手走脊髓（短），痛觉上大脑皮层（长）→ 先缩手、后觉疼"
    }
  ]
}
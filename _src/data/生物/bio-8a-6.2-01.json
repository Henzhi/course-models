  "legend": [
    {
      "color": "#e07a3c",
      "text": "刺激"
    },
    {
      "color": "#7a5cc4",
      "text": "神经冲动"
    },
    {
      "color": "#2f7d5c",
      "text": "肌肉收缩"
    }
  ],
  "parts": [
    {
      "id": "receptor",
      "name": "感受器",
      "en": "receptor",
      "only": "把刺激变成冲动",
      "desc": "皮肤里感觉神经的末梢（也叫感觉神经末梢）。",
      "role": "接受刺激，并把它转换成<b>神经冲动</b>——这是反射的起点。",
      "warn": "感受器在<b>皮肤</b>里，不是「手」这个整体。手是效应器所在的位置，两者不在同一处。"
    },
    {
      "id": "afferent",
      "name": "传入神经",
      "en": "afferent nerve",
      "only": "把冲动送进中枢",
      "desc": "把感受器和神经中枢连接起来的神经。",
      "role": "把感受器产生的神经冲动<b>传向</b>神经中枢。",
      "warn": "方向是<b>往里</b>。传入神经把「外面发生了什么」送进去，不负责发指令。"
    },
    {
      "id": "center",
      "name": "神经中枢",
      "en": "nerve center",
      "only": "处理信息、发出指令",
      "desc": "脊髓灰质里的一群神经元胞体（缩手反射的中枢就在脊髓）。",
      "role": "接收传入的冲动，经过突触把冲动传给另一个神经元，再发出指令。",
      "warn": "缩手反射的中枢在<b>脊髓</b>，不需要大脑参与——所以手先缩回来，你随后才觉得疼。"
    },
    {
      "id": "efferent",
      "name": "传出神经",
      "en": "efferent nerve",
      "only": "把指令送出去",
      "desc": "把神经中枢和效应器连接起来的神经。",
      "role": "把中枢发出的指令<b>传向</b>效应器。",
      "warn": "方向是<b>往外</b>。传入进、传出出——这两个名字的方向记反，整道题就废了。"
    },
    {
      "id": "effector",
      "name": "效应器",
      "en": "effector",
      "only": "做出动作",
      "desc": "传出神经末梢以及它所支配的肌肉或腺体。",
      "role": "接收指令并<b>做出反应</b>——缩手反射里就是手臂上的肌肉收缩。",
      "warn": "效应器是「<b>神经末梢 + 肌肉（或腺体）</b>」，不只是神经末梢，也不是肌肉单独一个。"
    },
    {
      "id": "brain",
      "name": "大脑皮层",
      "en": "cerebral cortex",
      "only": "产生痛觉",
      "desc": "大脑的表层，是感觉、运动等高级中枢所在的地方。",
      "role": "痛觉在这里形成。缩手反射的冲动也会上行传到大脑，但那是「另一条更长的路」。",
      "warn": "痛觉<b>在大脑皮层形成</b>，不在手上、也不在脊髓里。所以先缩手、后觉得疼。"
    }
  ],

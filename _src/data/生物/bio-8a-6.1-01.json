  "parts": [
    {
      "id": "cornea",
      "name": "角膜",
      "en": "cornea",
      "only": "光进入眼球的第一道关口",
      "desc": "眼球最前面透明的膜，稍稍向前凸出。",
      "role": "让光线进入眼球，并承担一部分折射。",
      "warn": "角膜是<b>透明</b>的，不是白色部分（白色的是巩膜）。"
    },
    {
      "id": "lens",
      "name": "晶状体",
      "en": "lens",
      "only": "可以变凸变扁的「镜头」",
      "desc": "位于虹膜后面的双凸透镜状结构，有弹性，曲度可以调节。",
      "role": "折射光线，让物像正好落在视网膜上。看近处时曲度变大（变凸），看远处时曲度变小（变扁）。",
      "warn": "近视是晶状体<b>曲度过大</b>（或眼球前后径过长），使像落在视网膜<b>前方</b>——不是「落在后面」。"
    },
    {
      "id": "retina",
      "name": "视网膜",
      "en": "retina",
      "only": "成像的地方",
      "desc": "眼球内壁后面的一层膜，上面有大量感光细胞。",
      "role": "物像在这里形成，感光细胞把光信号变成神经冲动。",
      "warn": "视网膜只负责<b>成像</b>和<b>感光</b>，视觉最终在<b>大脑皮层</b>形成——不是眼睛「看见」的。"
    },
    {
      "id": "nerve",
      "name": "视神经",
      "en": "optic nerve",
      "only": "把信号送进大脑",
      "desc": "从眼球后部伸出的神经。",
      "role": "把视网膜产生的神经冲动传到大脑皮层的视觉中枢。",
      "warn": "视神经属<b>传入神经</b>——它把信息送进大脑，不是把指令传出来。"
    },
    {
      "id": "concave",
      "name": "凹透镜",
      "en": "concave lens",
      "only": "矫正近视",
      "desc": "中间薄、边缘厚的透镜，对光线有发散作用。",
      "role": "先把光线发散一点，让会聚点<b>后移</b>，正好落回视网膜上。",
      "warn": "近视配<b>凹透镜</b>，远视配<b>凸透镜</b>——两者不能互换，这是每年必考的一对。"
    },
    {
      "id": "focus_normal",
      "name": "会聚点（正常眼）",
      "en": "focal point",
      "only": "落在视网膜上",
      "desc": "光线经晶状体折射后相交的那一点，正常眼正好落在视网膜上。",
      "role": "成像清晰的前提：会聚点与视网膜重合。",
      "warn": "晶状体通过改变曲度来「调焦」，保证远近的物像都能落在视网膜上。"
    },
    {
      "id": "focus_myopic",
      "name": "会聚点（近视）",
      "en": "focal point",
      "only": "落在视网膜前方",
      "desc": "晶状体曲度过大或眼球前后径过长，光线过早会聚。",
      "role": "会聚点在视网膜之前，到达视网膜时已经散开，所以看远处模糊。",
      "warn": "近视的会聚点在视网膜<b>前</b>，不是后。判断近视远视只看这一点，不靠感觉。"
    },
    {
      "id": "focus_fixed",
      "name": "会聚点（矫正后）",
      "en": "focal point",
      "only": "推回视网膜上",
      "desc": "戴上凹透镜后，光线先被发散，会聚点后移。",
      "role": "会聚点重新落在视网膜上，视物恢复清晰。",
      "warn": "凹透镜把会聚点<b>往后推</b>，凸透镜把它<b>往前拉</b>——方向别记反。"
    }
  ],

  "steps": [
    {
      "name": "眼球：一台精密的相机",
      "say": "眼球里有四样关键结构：<b>角膜</b>让光进来，<b>晶状体</b>负责调焦，<b>视网膜</b>负责成像，<b>视神经</b>把信号送进大脑。",
      "stats": [
        {
          "v": "晶状体",
          "label": "调焦的"
        },
        {
          "v": "视网膜",
          "label": "成像的"
        },
        {
          "v": "大脑皮层",
          "label": "看见的地方"
        }
      ],
      "ask": "点四个结构各看一遍。特别注意最后一句：<b>「看见」发生在大脑，不在眼睛</b>——视网膜只负责成像和感光。",
      "note": "晶状体是唯一能<b>主动调节</b>的结构：看近处变凸，看远处变扁。近视的根源就在这里。",
      "parts": [
        "cornea",
        "lens",
        "retina",
        "nerve"
      ],
      "routes": [],
      "caption": "角膜 → 晶状体 → 视网膜（成像）→ 视神经 → 大脑皮层",
      "hide": [
        "focus_normal",
        "focus_myopic",
        "focus_fixed",
        "concave"
      ]
    },
    {
      "name": "正常眼：会聚在视网膜上",
      "say": "光线经角膜和晶状体折射后<b>会聚于一点</b>。这一点正好落在视网膜上，看东西就清楚。",
      "stats": [
        {
          "v": "在视网膜上",
          "label": "会聚点位置"
        },
        {
          "v": "清晰",
          "label": "结果"
        },
        {
          "v": "可调",
          "label": "晶状体曲度"
        }
      ],
      "ask": "盯住两条光线：一条平行射入、一条穿过中心，它们在<b>视网膜上</b>相交。这就是「看得清」的结构基础。",
      "note": "看远看近都能看清，是因为<b>晶状体曲度可以调节</b>——这叫作眼的调节。",
      "parts": [
        "lens",
        "retina",
        "focus_normal"
      ],
      "routes": [
        "n1",
        "n2"
      ],
      "caption": "正常眼：会聚点落在视网膜上",
      "hide": [
        "focus_myopic",
        "focus_fixed",
        "concave"
      ]
    },
    {
      "name": "近视：会聚在视网膜前面",
      "say": "如果晶状体<b>曲度过大</b>（太凸）或眼球前后径过长，会聚点就会落在视网膜<b>前方</b>，看远处就模糊。",
      "stats": [
        {
          "v": "视网膜前",
          "label": "会聚点位置"
        },
        {
          "v": "曲度过大",
          "label": "常见原因"
        },
        {
          "v": "看远模糊",
          "label": "表现"
        }
      ],
      "ask": "对比上一步：会聚点从视网膜上<b>前移</b>了。所以要矫正，就得把会聚点「往后推」。",
      "note": "近视的会聚点在视网膜<b>前面</b>，不是后面。判断近视还是远视，只看这一点。",
      "parts": [
        "lens",
        "retina",
        "focus_myopic"
      ],
      "routes": [
        "m1",
        "m2"
      ],
      "caption": "近视：晶状体曲度过大，会聚点在视网膜前方",
      "hide": [
        "focus_normal",
        "focus_fixed",
        "concave"
      ]
    },
    {
      "name": "矫正：用凹透镜把它推回去",
      "say": "在眼前加一片<b>凹透镜</b>。凹透镜对光有<b>发散</b>作用，先把光线散开一些，会聚点就<b>后移</b>回视网膜上。",
      "stats": [
        {
          "v": "凹透镜",
          "label": "近视戴什么"
        },
        {
          "v": "发散",
          "label": "凹透镜的作用"
        },
        {
          "v": "后移",
          "label": "会聚点怎么变"
        }
      ],
      "ask": "看蓝色那条光路：光线先经过凹透镜被<b>散开</b>，再经晶状体才重新会聚——这一次正好落在视网膜上。",
      "note": "<b>近视配凹透镜，远视配凸透镜</b>。凹透镜发散、凸透镜会聚，两个方向正好相反。",
      "parts": [
        "lens",
        "retina",
        "focus_fixed",
        "concave"
      ],
      "routes": [
        "f1",
        "f2"
      ],

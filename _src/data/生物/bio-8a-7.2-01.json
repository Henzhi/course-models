  "steps": [
    {
      "name": "三道防线，一道比一道专",
      "say": "人体有三道防线：<b>皮肤和黏膜</b>、<b>体液中的杀菌物质和吞噬细胞</b>、<b>免疫器官和免疫细胞</b>。前两道生来就有，第三道后天才能获得。",
      "stats": [
        {
          "v": "3 道",
          "label": "防线"
        },
        {
          "v": "前 2 道",
          "label": "非特异性"
        },
        {
          "v": "第 3 道",
          "label": "特异性"
        }
      ],
      "ask": "点每一道防线看它的作用。病原体从左边来，一路往右闯——看它能在哪一道被拦下。",
      "note": "前两道防线<b>对多种病原体都有效</b>（不挑对象），第三道<b>只对特定的病原体</b>有效。这就是「非特异性」和「特异性」的区别。",
      "parts": [
        "skin",
        "lysozyme",
        "phagocyte",
        "lymph",
        "antibody",
        "pathogen"
      ],
      "routes": [
        "p1"
      ],
      "caption": "第一道（皮肤黏膜）→ 第二道（杀菌物质、吞噬细胞）→ 第三道（淋巴细胞、抗体）"
    },
    {
      "name": "第一道：皮肤和黏膜",
      "say": "<b>皮肤</b>挡住病原体，<b>黏膜</b>分泌黏液粘住它们，呼吸道黏膜上的纤毛再把它们扫出去。",
      "stats": [
        {
          "v": "生来就有",
          "label": "获得方式"
        },
        {
          "v": "多种病原体",
          "label": "作用范围"
        },
        {
          "v": "非特异性",
          "label": "免疫类型"
        }
      ],
      "ask": "注意墙上那个<b>缺口</b>——皮肤破损时这道防线就被突破了，病原体从这里钻进去。所以伤口要清洗、包扎。",
      "note": "第一道防线是<b>物理屏障</b>：挡住、粘住、扫走，不针对某一种病原体。",
      "parts": [
        "skin",
        "pathogen"
      ],
      "routes": [
        "p1",
        "p2"
      ],
      "caption": "第一道：皮肤阻挡、黏膜粘住并清扫（非特异性）"
    },
    {
      "name": "第二道：杀菌物质和吞噬细胞",
      "say": "钻进组织的病原体会遇到<b>溶菌酶</b>（溶解细菌的细胞壁）和<b>吞噬细胞</b>（直接吞掉）。",
      "stats": [
        {
          "v": "生来就有",
          "label": "获得方式"
        },
        {
          "v": "多种病原体",
          "label": "作用范围"
        },
        {
          "v": "非特异性",
          "label": "免疫类型"
        }
      ],
      "ask": "看吞噬细胞伸出的<b>伪足</b>：它把病原体包起来，吞进细胞里消化掉。这一道也不挑对象。",
      "note": "溶菌酶和吞噬细胞都属于<b>第二道</b>防线。它们<b>不是</b>第三道——第三道才靠抗体。",
      "parts": [
        "lysozyme",
        "phagocyte",
        "pathogen"
      ],
      "routes": [
        "p2",
        "p3"
      ],
      "caption": "第二道：溶菌酶溶解、吞噬细胞吞噬（非特异性）"
    },
    {
      "name": "第三道：淋巴细胞和抗体",
      "say": "漏网的病原体进入淋巴结，<b>淋巴细胞</b>受刺激产生<b>抗体</b>。抗体像「Y 形的夹子」，专门夹住这种病原体。",
      "stats": [
        {
          "v": "后天获得",
          "label": "获得方式"
        },
        {
          "v": "特定病原体",
          "label": "作用范围"
        },
        {
          "v": "特异性",
          "label": "免疫类型"
        }
      ],
      "ask": "抗体的形状像 Y，两个「叉」正好卡住抗原。注意它是<b>专门</b>为这一种病原体造的——换一种就夹不住了。",
      "note": "抗体有<b>专一性</b>：一种抗体只对一种抗原有效。所以得过麻疹不会再得，但明年照样会得流感。",
      "parts": [
        "lymph",
        "antibody",
        "pathogen"
      ],
      "routes": [
        "p4",
        "p5",
        "antibody"
      ],
      "caption": "第三道：淋巴细胞产生抗体，抗体与抗原特异性结合"
    },
    {
      "name": "非特异性 vs 特异性",
      "say": "前两道<b>生来就有、不挑对象</b>；第三道<b>后天获得、只认一种</b>。疫苗就是利用第三道的原理。",
      "stats": [
        {
          "v": "非特异性",
          "label": "第一、二道"
        },
        {
          "v": "特异性",
          "label": "第三道"
        },
        {
          "v": "抗原",
          "label": "疫苗是什么"
        }
      ],
      "ask": "看最后一列的问题：<b>疫苗是抗原还是抗体？</b>——是抗原。接种疫苗是把灭活或减毒的病原体送进去，让身体自己产生抗体。",
      "note": "接种疫苗后，人体产生了针对这种病原体的<b>抗体</b>，下次真的病原体入侵时就能迅速清除——这就是免疫规划的原理。",

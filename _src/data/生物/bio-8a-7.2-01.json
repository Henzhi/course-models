  "parts": [
    {
      "id": "skin",
      "name": "第一道防线：皮肤和黏膜",
      "en": "skin & mucous membrane",
      "only": "挡住 + 杀菌 + 清扫",
      "desc": "皮肤覆盖全身表面，呼吸道、消化道等腔道内表面是黏膜。",
      "role": "皮肤阻挡病原体侵入；黏膜分泌黏液粘住病原体，呼吸道黏膜上的纤毛还会把它扫出去。",
      "warn": "皮肤<b>破损</b>时这道防线被突破，病原体就从缺口进去了——所以伤口要处理。"
    },
    {
      "id": "lysozyme",
      "name": "杀菌物质（溶菌酶）",
      "en": "lysozyme",
      "only": "溶解细菌的细胞壁",
      "desc": "体液（如泪液、唾液、血浆）中的一类物质。",
      "role": "能破坏许多种细菌的细胞壁，使细菌溶解死亡。",
      "warn": "溶菌酶属于<b>第二道</b>防线，不是第一道。它存在于体液里，不在皮肤表面。"
    },
    {
      "id": "phagocyte",
      "name": "吞噬细胞",
      "en": "phagocyte",
      "only": "吞掉病原体",
      "desc": "体液和组织中的一类白细胞，能伸出伪足包住病原体。",
      "role": "把病原体吞入细胞内消化掉，是第二道防线的主力。",
      "warn": "吞噬细胞属于<b>第二道</b>防线（非特异性），不是第三道。第三道才靠淋巴细胞和抗体。"
    },
    {
      "id": "lymph",
      "name": "淋巴细胞",
      "en": "lymphocyte",
      "only": "产生抗体",
      "desc": "免疫器官（如淋巴结、脾）里的一种白细胞。",
      "role": "受到抗原刺激后产生<b>抗体</b>，抗体与抗原特异性结合，把病原体清除掉。",
      "warn": "第三道防线是<b>后天获得</b>的，只对<b>特定</b>的病原体起作用——这叫特异性免疫。"
    },
    {
      "id": "antibody",
      "name": "抗体",
      "en": "antibody",
      "only": "专抓一种抗原",
      "desc": "淋巴细胞产生的蛋白质，形状像「Y」，能与对应的抗原结合。",
      "role": "与抗原<b>特异性结合</b>，使病原体失去活性或被吞噬细胞清除。",
      "warn": "抗体有<b>专一性</b>：一种抗体只对一种抗原有效。所以得过麻疹不会再得，但仍会得流感。"
    },
    {
      "id": "pathogen",
      "name": "病原体",
      "en": "pathogen",
      "only": "入侵者",
      "desc": "能引起疾病的细菌、病毒、真菌、寄生虫等。",
      "role": "突破防线、在体内繁殖，就可能导致疾病。",
      "warn": "疫苗是<b>抗原</b>（灭活或减毒的病原体），不是抗体。接种疫苗是让身体自己产生抗体。"
    }
  ],

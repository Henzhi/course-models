{
  "canvas": {
    "w": 900,
    "h": 560
  },
  "hero": {
    "title": "草履虫：一个细胞，就是一个完整生命",
    "goal": "草履虫只有一个细胞，却能运动、摄食、呼吸、排泄、繁殖——所有生命活动都由这一个细胞完成。",
    "tips": [
      "点图中任意结构，看它负责哪一项生命活动",
      "点「怎么动·怎么吃」，看摄食这条线",
      "点「排泄·呼吸」，看废物是怎么排出去的"
    ]
  },
  "groups": [
    {
      "label": "怎么动·怎么吃",
      "title": "运动与摄食",
      "lead": "靠纤毛摆动前进，靠口沟把食物送进细胞，再在食物泡里消化。",
      "items": "纤毛 · 口沟 · 食物泡",
      "tip": "食物泡是「消化袋」，不是排泄结构——消化完的残渣从胞肛排出去。",
      "ids": [
        "cilia",
        "oral",
        "food"
      ]
    },
    {
      "label": "排泄·呼吸",
      "title": "排泄与气体交换",
      "lead": "伸缩泡把多余的水和代谢废物收起来排出去；表膜负责气体交换。",
      "items": "伸缩泡（含收集管）· 表膜 · 胞肛",
      "tip": "伸缩泡排的是水和代谢废物，食物残渣走胞肛——两条路别混。",
      "ids": [
        "contractile",
        "membrane",
        "anal"
      ]
    },
    {
      "label": "控制中心",
      "title": "控制与遗传",
      "lead": "草履虫有大小两个核：大核管日常代谢，小核管生殖。",
      "items": "大核 · 小核",
      "tip": "草履虫是真核生物（有细胞核），但整个身体只有一个细胞——这两句话不矛盾。",
      "ids": [
        "macro",
        "micro"
      ]
    }
  ],
  "parts": [
    {
      "id": "cilia",
      "name": "纤毛",
      "en": "cilia",
      "only": "运动结构",
      "desc": "身体表面密密麻麻的细短毛，靠摆动让草履虫在水里前进。",
      "role": "运动。纤毛按顺序摆动，草履虫一边前进一边旋转。",
      "warn": "纤毛只负责运动，不负责摄食——虽然它摆动带起的水流会把食物送到口沟附近。"
    },
    {
      "id": "membrane",
      "name": "表膜",
      "en": "pellicle",
      "only": "相当于细胞膜",
      "desc": "包在草履虫身体最外面的一层膜。",
      "role": "保护身体，并完成气体交换——水里的氧气从表膜进入，二氧化碳从表膜排出。",
      "warn": "草履虫没有专门的呼吸器官，气体交换就靠表膜。"
    },
    {
      "id": "cyto",
      "name": "细胞质",
      "en": "cytoplasm",
      "only": "基本结构",
      "desc": "表膜以内、细胞核以外的部分。",
      "role": "各种结构都悬浮在细胞质里，生命活动在这里进行。",
      "warn": "草履虫是单细胞生物，细胞质里的这些结构，就相当于它的「器官」。"
    },
    {
      "id": "oral",
      "name": "口沟",
      "en": "oral groove",
      "only": "摄食",
      "desc": "身体一侧凹陷成的一条沟，纤毛摆动把细菌、微小藻类等食物送进去。",
      "role": "摄食。食物从口沟进入细胞内部，被膜包起来形成食物泡。",
      "warn": "口沟只「进」不「出」。食物残渣是从胞肛排出去的。"
    },
    {
      "id": "food",
      "name": "食物泡",
      "en": "food vacuole",
      "only": "消化",
      "desc": "食物进入细胞后被膜包起来形成的小泡。",
      "role": "消化。食物泡在细胞质里流动，里面的食物被逐渐消化、吸收。",
      "warn": "食物泡是「消化袋」，不是排泄结构。消化完的残渣最后从胞肛排出。"
    },
    {
      "id": "anal",
      "name": "胞肛",
      "en": "anal pore",
      "only": "排残渣",
      "desc": "身体表面一个很小的开口。",
      "role": "把消化完的食物残渣排出体外。",
      "warn": "胞肛排的是「没消化的残渣」，伸缩泡排的是「代谢废物」——这两条路别混。"
    },
    {
      "id": "contractile",
      "name": "伸缩泡",
      "en": "contractile vacuole",
      "only": "排泄",
      "desc": "前后各一个泡状结构，每个周围还有几条放射状的收集管。",
      "role": "收集多余的水和代谢废物，装满后收缩，把内容物排出体外。",
      "warn": "伸缩泡排的是水和代谢废物，食物残渣走胞肛。"
    },
    {
      "id": "macro",
      "name": "大核",
      "en": "macronucleus",
      "only": "控制代谢",
      "desc": "身体中央一个较大的肾形核。",
      "role": "控制日常的代谢活动。",
      "warn": "草履虫有大小两个核，这是它和细菌最大的区别之一——细菌没有成形的细胞核。"
    },
    {
      "id": "micro",
      "name": "小核",
      "en": "micronucleus",
      "only": "与生殖有关",
      "desc": "大核旁边一个较小的球形核。",
      "role": "与生殖有关。",
      "warn": "大核管代谢，小核管生殖，别记反。"
    }
  ],

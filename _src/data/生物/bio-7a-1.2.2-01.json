{
  "canvas": {
    "w": 960,
    "h": 520
  },
  "hero": {
    "title": "植物细胞 与 动物细胞",
    "goal": "两种细胞都有细胞膜、细胞质、细胞核和线粒体；植物细胞还多了细胞壁、液泡，绿色部分还有叶绿体。",
    "tips": [
      "点图中任意结构，看它是什么、有什么用",
      "点「共同结构」，看两者都有的部分",
      "点「不同结构」，看植物细胞到底多在哪"
    ]
  },
  "groupSame": {
    "title": "共同结构：四样都有",
    "lead": "不管是植物还是动物，细胞都靠这四样维持基本生命活动。",
    "items": "细胞膜 · 细胞质 · 细胞核 · 线粒体",
    "tip": "动物细胞没有细胞壁、液泡、叶绿体，但这四样一个都不少。"
  },
  "groupDiff": {
    "title": "不同结构：植物多三样",
    "lead": "植物细胞比动物细胞多出来的三样，都和「它是植物」有关。",
    "items": "细胞壁（支撑形状）· 液泡（储存细胞液）· 叶绿体（光合作用，仅绿色部分）",
    "tip": "口诀：一壁、一泡、一绿体。"
  },
  "parts": [
    {
      "id": "wall",
      "name": "细胞壁",
      "en": "cell wall",
      "only": "植物细胞有",
      "desc": "植物细胞最外面的一层「墙」，主要成分是纤维素。",
      "role": "支持和保护细胞，让植物细胞有比较固定的形状——所以树干、菜梗是硬的。",
      "warn": "细胞壁不是细胞膜，它在细胞膜的外面。而且细胞壁是全透性的，不负责控制物质进出。"
    },
    {
      "id": "membrane",
      "name": "细胞膜",
      "en": "cell membrane",
      "only": "动植物细胞都有",
      "desc": "紧贴细胞壁内侧的一层薄膜；在动物细胞里，它就是细胞最外面的一层。",
      "role": "保护细胞，并控制物质进出——有用的物质进来，废物排出去。",
      "warn": "细胞膜很薄，光学显微镜下不容易看清。你在显微镜里看到的「边界」，往往是细胞壁。"
    },
    {
      "id": "cyto",
      "name": "细胞质",
      "en": "cytoplasm",
      "only": "动植物细胞都有",
      "desc": "细胞膜以内、细胞核以外的部分，能缓缓流动。",
      "role": "许多生命活动在这里进行；里面悬浮着液泡、叶绿体、线粒体等各种结构。",
      "warn": "细胞质不等于细胞液。细胞液是液泡里面的液体，两者别混。"
    },
    {
      "id": "nucleus",
      "name": "细胞核",
      "en": "nucleus",
      "only": "动植物细胞都有",
      "desc": "细胞里一个近似球形的结构，里面有遗传物质 DNA。",
      "role": "控制细胞的生长、发育和繁殖，可以理解为细胞的「控制中心」。",
      "warn": "遗传信息在细胞核里的 DNA 上，不在细胞质里。这是后面学遗传的基础。"
    },
    {
      "id": "vacuole",
      "name": "液泡",
      "en": "vacuole",
      "only": "植物细胞有",
      "desc": "植物细胞里一个大的泡状结构，里面装着细胞液。",
      "role": "细胞液里溶有糖分、色素等物质。西瓜甜、花瓣有颜色，都和液泡里的细胞液有关。",
      "warn": "动物细胞没有大液泡。看到一个大液泡，基本可以判断这是植物细胞。"
    },
    {
      "id": "chloro",
      "name": "叶绿体",
      "en": "chloroplast",
      "only": "植物绿色部分才有",
      "desc": "植物细胞里绿色的椭圆形结构，里面含有叶绿素。",
      "role": "进行光合作用，把光能转变成化学能，制造有机物——植物因此被称为「生产者」。",
      "warn": "只有植物体的绿色部分才有叶绿体。洋葱鳞片叶内表皮细胞、萝卜的根细胞都没有叶绿体，所以实验里看到的是无色透明的。这一条考得最多。"
    },
    {
      "id": "mito",
      "name": "线粒体",
      "en": "mitochondrion",
      "only": "动植物细胞都有",
      "desc": "动植物细胞里都有的一种小结构，光学显微镜下呈小颗粒状。",
      "role": "进行呼吸作用，分解有机物、释放能量，被称为细胞的「动力车间」。",
      "warn": "线粒体不是植物特有的，动物细胞里同样有——而且越活跃的细胞（如心肌细胞）数量越多。"
    }
  ],

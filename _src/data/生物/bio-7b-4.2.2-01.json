  "legend": [
    {
      "color": "#c9764f",
      "text": "消化道（食物经过的地方）"
    },
    {
      "color": "#5b9d6e",
      "text": "消化腺（分泌消化液）"
    }
  ],
  "parts": [
    {
      "id": "mouth",
      "name": "口腔",
      "en": "mouth",
      "only": "淀粉从这里开始",
      "desc": "消化道的起点，里面有牙齿、舌和唾液腺的开口。",
      "role": "牙齿把食物嚼碎（物理性消化），唾液把淀粉分解成麦芽糖（化学性消化）。舌负责搅拌并把食物送进食道。",
      "warn": "口腔只消化<b>淀粉</b>。蛋白质和脂肪在这里一点都没变。"
    },
    {
      "id": "stomach",
      "name": "胃",
      "en": "stomach",
      "only": "蛋白质从这里开始",
      "desc": "消化道最膨大的一段，能暂时储存食物，壁上有发达的肌肉。",
      "role": "胃壁肌肉收缩把食物和胃液搅匀；胃液里的蛋白酶把蛋白质初步分解。",
      "warn": "淀粉在胃里<b>停止</b>消化——胃液是强酸的，唾液淀粉酶在这里失去活性。"
    },
    {
      "id": "small",
      "name": "小肠",
      "en": "small intestine",
      "only": "消化和吸收的主战场",
      "desc": "消化道最长的一段（约 5–6 米），内壁有大量环形皱襞和小肠绒毛。",
      "role": "胆汁、胰液、肠液三种消化液在这里汇合，淀粉、蛋白质、脂肪被彻底分解成可吸收的小分子；分解产物也主要在这里被吸收。",
      "warn": "小肠既是<b>消化</b>的主要器官，也是<b>吸收</b>的主要器官——两个「主要」都在这里。"
    },
    {
      "id": "large",
      "name": "大肠",
      "en": "large intestine",
      "only": "吸收水分",
      "desc": "消化道最后一段（约 1.5 米），比小肠短但更粗。",
      "role": "吸收食物残渣里的少量水分、无机盐和部分维生素，把剩下的残渣变成粪便。",
      "warn": "大肠<b>不是</b>吸收养分的主要场所。别把「吸收水分」记成「吸收营养」。"
    },
    {
      "id": "anus",
      "name": "肛门",
      "en": "anus",
      "only": "排出残渣",
      "desc": "消化道的出口。",
      "role": "把粪便排出体外。",
      "warn": "排出的粪便主要是没被消化吸收的食物残渣，不是「代谢废物」——代谢废物靠泌尿系统排出。"
    }
  ],

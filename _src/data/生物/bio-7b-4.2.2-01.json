  "steps": [
    {
      "name": "全程认路",
      "say": "食物从进嘴到排出，要走一条约 <b>8–9 米</b>的管道。顺序是：口腔 → 咽、食道 → 胃 → 小肠 → 大肠 → 肛门。",
      "stats": [
        {
          "v": "8–9 米",
          "label": "全长"
        },
        {
          "v": "6 站",
          "label": "经过的器官"
        },
        {
          "v": "单向",
          "label": "通行方向"
        }
      ],
      "ask": "跟着白色小球走一遍。注意它在<b>小肠</b>里绕了最久——这一段占了整条管道的一大半。",
      "note": "消化道是一条<b>单向</b>的管道，食物只能往前走；推动它的力量来自管壁肌肉的收缩。",
      "parts": [
        "mouth",
        "stomach",
        "small",
        "large",
        "anus"
      ],
      "routes": [
        "mouth",
        "small",
        "large"
      ],
      "caption": "消化道：口腔 → 食道 → 胃 → 小肠 → 大肠 → 肛门"
    },
    {
      "name": "口腔：淀粉从这里开始",
      "say": "淀粉的消化<b>从口腔就开始了</b>。唾液里的唾液淀粉酶把淀粉分解成麦芽糖。",
      "stats": [
        {
          "v": "淀粉 → 麦芽糖",
          "label": "发生的变化"
        },
        {
          "v": "牙齿",
          "label": "物理性消化"
        },
        {
          "v": "舌",
          "label": "搅拌、吞咽"
        }
      ],
      "ask": "回忆一下：馒头越嚼越甜。那个甜味不是本来就有的——是淀粉被分解成了麦芽糖。",
      "note": "口腔只处理<b>淀粉</b>。蛋白质、脂肪在这里完全没变。",
      "parts": [
        "mouth"
      ],
      "routes": [
        "mouth"
      ],
      "caption": "口腔：牙齿嚼碎（物理）+ 唾液分解淀粉（化学）"
    },
    {
      "name": "胃：蛋白质从这里开始",
      "say": "蛋白质的消化<b>从胃开始</b>。胃液里的蛋白酶把蛋白质初步分解，同时胃壁肌肉不停搅拌。",
      "stats": [
        {
          "v": "蛋白质",
          "label": "这里开始消化"
        },
        {
          "v": "胃液",
          "label": "蛋白酶 + 强酸"
        },
        {
          "v": "暂停",
          "label": "淀粉在这里停下"
        }
      ],
      "ask": "找一下矛盾点：淀粉从口腔开始消化，为什么到了胃里反而<b>停了</b>？——胃液是强酸的，唾液淀粉酶在这里失去活性。",
      "note": "胃主要消化<b>蛋白质</b>；淀粉和脂肪的主战场在下一站。",
      "parts": [
        "stomach"
      ],
      "routes": [
        "mouth"
      ],
      "caption": "胃：蛋白质在此开始被分解，淀粉的消化在此暂停"
    },
    {
      "name": "小肠：三种消化液汇合",
      "say": "这里是<b>主战场</b>：胆汁、胰液、肠液三种消化液在这里汇合，三大类营养物质全部被彻底分解。",
      "stats": [
        {
          "v": "3 种",
          "label": "汇合的消化液"
        },
        {
          "v": "0 种酶",
          "label": "胆汁含的消化酶"
        },
        {
          "v": "三大类",
          "label": "全部在此分解"
        }
      ],
      "ask": "重点看胆汁：它把脂肪<b>切成小滴</b>（物理性消化），本身<b>不含消化酶</b>。真正把脂肪分解掉的是胰液和肠液。",
      "note": "<b>胆汁不含消化酶</b>——这是本节最高频的错点。它做的是「把大块切小」，不是「把分子拆开」。",
      "parts": [
        "small"
      ],
      "routes": [
        "small"
      ],
      "caption": "小肠：胆汁（切小脂肪滴）+ 胰液 + 肠液 → 三大类彻底分解"
    },
    {
      "name": "吸收：主战场也在小肠",
      "say": "消化完的养分主要在小肠被吸收。小肠内壁有大量<b>绒毛</b>，把吸收面积放大到约 <b>200 平方米</b>。",
      "stats": [
        {
          "v": "≈200 m²",
          "label": "小肠吸收面积"
        },
        {
          "v": "少量",
          "label": "大肠吸收的水分"
        },
        {
          "v": "粪便",
          "label": "最终排出的残渣"
        }
      ],
      "ask": "大肠这一段只管<b>吸水</b>。如果大肠吸水太少会腹泻，吸水太多会便秘——吸收功能出问题的直接后果。",
      "note": "小肠是<b>消化</b>的主要器官，也是<b>吸收</b>的主要器官。两个「主要」都在小肠。",
      "parts": [
        "small",
        "large"
      ],
      "routes": [
        "small",
        "large"
      ],
      "caption": "小肠绒毛吸收养分；大肠吸收少量水分后形成粪便"
    }
  ]
}
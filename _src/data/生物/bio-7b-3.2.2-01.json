  "steps": [
    {
      "name": "光合作用：造有机物",
      "say": "叶绿体用<b>光</b>作动力，把<b>二氧化碳和水</b>变成<b>有机物</b>，同时放出<b>氧气</b>。",
      "stats": [
        {
          "v": "叶绿体",
          "label": "场所"
        },
        {
          "v": "需要光",
          "label": "条件"
        },
        {
          "v": "有机物 + 氧",
          "label": "产物"
        }
      ],
      "ask": "跟着三种颜色的粒子各走一遍：二氧化碳从气孔进、水从导管来、氧气从气孔出。它们最后都汇到同一个地方——叶绿体。",
      "note": "光合作用是把<b>光能变成化学能</b>、储存在有机物里的过程。所以它是「<b>存</b>能量」。",
      "parts": [
        "chloroplast",
        "cell",
        "stoma",
        "vessel",
        "sun"
      ],
      "routes": [
        "co2in",
        "waterin",
        "o2out"
      ],
      "caption": "光合作用：二氧化碳 + 水 —(光能·叶绿体)→ 有机物 + 氧"
    },
    {
      "name": "呼吸作用：放出能量",
      "say": "线粒体把<b>有机物</b>分解，需要<b>氧气</b>，产生<b>二氧化碳和水</b>，同时把能量<b>释放</b>出来。",
      "stats": [
        {
          "v": "线粒体",
          "label": "场所"
        },
        {
          "v": "昼夜都进行",
          "label": "条件"
        },
        {
          "v": "二氧化碳 + 水 + 能量",
          "label": "产物"
        }
      ],
      "ask": "注意方向全部反过来：氧气<b>从气孔进</b>、二氧化碳<b>从气孔出</b>，有机物从叶绿体送到线粒体。",
      "note": "呼吸作用是<b>释放</b>能量，供细胞的生命活动使用。所以它是「<b>花</b>能量」。",
      "parts": [
        "mito",
        "cell",
        "stoma",
        "chloroplast"
      ],
      "routes": [
        "o2in",
        "organic",
        "co2out",
        "energy"
      ],
      "caption": "呼吸作用：有机物 + 氧 → 二氧化碳 + 水 + 能量（线粒体）"
    },
    {
      "name": "白天：两个都在跑",
      "say": "白天不是「只光合不呼吸」——<b>两个同时在跑</b>，只是光合比呼吸强，所以净结果是往里吸二氧化碳、往外放氧气。",
      "stats": [
        {
          "v": "光合 > 呼吸",
          "label": "强弱"
        },
        {
          "v": "净吸 CO₂",
          "label": "白天"
        },
        {
          "v": "净放 O₂",
          "label": "白天"
        }
      ],
      "ask": "把这一步和下一步对比着看：同一个气孔，白天净往里进二氧化碳，夜里净往外出二氧化碳——<b>方向反了</b>。",
      "note": "「植物白天只光合、晚上才呼吸」是<b>最常见的错</b>。呼吸作用与光无关，一天到晚都在进行。",
      "parts": [
        "sun",
        "chloroplast",
        "mito",
        "stoma"
      ],
      "routes": [
        "co2in",
        "waterin",
        "o2out"
      ],
      "caption": "白天：光合作用强于呼吸作用 → 净吸收二氧化碳、净释放氧"
    },
    {
      "name": "夜里：只有呼吸",
      "say": "没有光，叶绿体停工，但线粒体<b>照常上班</b>：吸氧气、放二氧化碳。",
      "stats": [
        {
          "v": "线粒体",
          "label": "唯一在工作的"
        },
        {
          "v": "净吸 O₂",
          "label": "夜里"
        },
        {
          "v": "净放 CO₂",
          "label": "夜里"
        }
      ],
      "ask": "这就是为什么卧室里不宜摆太多绿植——夜里它们和你抢氧气、还要放二氧化碳。",
      "note": "白天与夜里的差别，<b>只在于有没有光合作用</b>；呼吸作用从来没停过。",
      "parts": [
        "mito",
        "cell",
        "stoma"
      ],
      "routes": [
        "o2in",
        "co2out",
        "energy"
      ],
      "caption": "夜里：只有呼吸作用 → 净吸收氧、净释放二氧化碳"
    },
    {
      "name": "一张表看清区别",
      "say": "两个过程<b>互为原料和产物</b>：光合造出来的有机物和氧，正好是呼吸的原料；呼吸产生的二氧化碳和水，正好是光合的原料。",
      "stats": [
        {
          "v": "存 ↔ 花",
          "label": "能量"
        },
        {
          "v": "叶绿体 ↔ 线粒体",
          "label": "场所"
        }
      ],
      "ask": "背这张表不要按行背：按「场所 → 条件 → 原料 → 产物」走一遍，再倒着走一遍。最后补一句范围——<b>光合只发生在含叶绿体的细胞，呼吸发生在所有活细胞</b>。",
      "note": "一句话收口：<b>光合作用储存能量，呼吸作用释放能量；前者只在有光时进行，后者昼夜不停。</b>",
      "parts": [
        "chloroplast",
        "mito",
        "cell",
        "stoma"
      ],
      "routes": [],

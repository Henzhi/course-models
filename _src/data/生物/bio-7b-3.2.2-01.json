  "parts": [
    {
      "id": "cell",
      "name": "叶肉细胞",
      "en": "mesophyll cell",
      "only": "两个过程都在这里发生",
      "desc": "叶片内部含有大量叶绿体的薄壁细胞。",
      "role": "光合作用在它的叶绿体里进行，呼吸作用在它的线粒体里进行——同一个细胞，两套「车间」。",
      "warn": "光合作用只在<b>有叶绿体的细胞</b>里进行（主要是叶肉细胞），而呼吸作用<b>所有活细胞</b>都能进行。"
    },
    {
      "id": "chloroplast",
      "name": "叶绿体",
      "en": "chloroplast",
      "only": "光合作用的场所",
      "desc": "细胞质里绿色的椭圆形细胞器，含叶绿素。",
      "role": "吸收光能，把二氧化碳和水合成有机物（主要是淀粉），同时放出氧气。光能在这里变成化学能，储存在有机物中。",
      "warn": "叶绿体是<b>储存</b>能量，不是释放能量。释放能量的是线粒体。这一对最容易记反。"
    },
    {
      "id": "mito",
      "name": "线粒体",
      "en": "mitochondrion",
      "only": "呼吸作用的场所",
      "desc": "细胞质里的小颗粒状细胞器，动植物细胞都有。",
      "role": "把有机物分解成二氧化碳和水，同时把储存在有机物里的能量释放出来，供细胞的生命活动使用。",
      "warn": "线粒体<b>昼夜都在工作</b>。白天光合作用强，呼吸作用也没停，只是被光合「盖住」了。"
    },
    {
      "id": "stoma",
      "name": "气孔",
      "en": "stoma",
      "only": "气体进出的门",
      "desc": "叶片下表皮上由两个保卫细胞围成的开口。",
      "role": "二氧化碳从这里进、氧气从这里出（光合作用）；氧气从这里进、二氧化碳从这里出（呼吸作用）。同一个口，方向随昼夜变。",
      "warn": "气孔是<b>一扇门两个方向</b>：白天净往里进二氧化碳，夜里净往外排二氧化碳。"
    },
    {
      "id": "vessel",
      "name": "导管",
      "en": "vessel",
      "only": "运来水",
      "desc": "叶脉里的输导组织，从根一直通到叶。",
      "role": "把根吸收的水送到叶肉细胞，作为光合作用的原料之一。",
      "warn": "光合作用用的水由<b>根</b>吸收、经<b>导管</b>运来，不是叶片自己造的。"
    },
    {
      "id": "sun",
      "name": "光",
      "en": "light",
      "only": "光合作用的条件",
      "desc": "太阳光（或灯光）提供的能量。",
      "role": "光合作用必须有光才能进行。没有光，叶绿体就停工。",
      "warn": "「有光才光合」不等于「没光就不呼吸」。呼吸作用与光无关，一天到晚都在进行。"
    }
  ],

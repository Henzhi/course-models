  "steps": [
    {
      "name": "一滴水的旅程",
      "say": "土壤里的水，要从<b>根毛</b>进、沿<b>导管</b>上、最后由<b>气孔</b>出去。三步走完，就是这一节。",
      "stats": [
        {
          "v": "3 段",
          "label": "路程"
        },
        {
          "v": "1 条",
          "label": "上行通道"
        },
        {
          "v": "99%",
          "label": "从气孔散失的比例"
        }
      ],
      "ask": "跟着蓝色小球走一遍：从土壤出来 → 沿根向上 → 穿过茎 → 到叶脉 → 从气孔飘走。",
      "note": "根吸收的水，<b>绝大部分都通过蒸腾作用散失了</b>（约 99%），只有一小部分用于光合作用等生命活动。",
      "parts": [
        "root_hair",
        "root",
        "stem",
        "vessel",
        "leaf",
        "stoma",
        "guard"
      ],
      "routes": [
        "absorb",
        "rise",
        "transpire"
      ],
      "caption": "土壤 → 根毛 → 根 → 茎（导管）→ 叶脉 → 气孔 → 空气"
    },
    {
      "name": "根毛吸水",
      "say": "根吸水靠的是<b>根毛</b>：根尖表皮细胞向外伸出的一根根细突起。",
      "stats": [
        {
          "v": "极大",
          "label": "表面积"
        },
        {
          "v": "水和无机盐",
          "label": "吸收的东西"
        },
        {
          "v": "成熟区",
          "label": "根毛所在部位"
        }
      ],
      "ask": "为什么要长这么多根毛？——表面积越大，吸水越快。移栽植物时伤了根毛，植物就会萎蔫，原因也在这里。",
      "note": "根吸收的是<b>水和无机盐</b>，<b>不吸收有机物</b>。有机物是叶片光合作用制造的。",
      "parts": [
        "root_hair",
        "root"
      ],
      "routes": [
        "absorb"
      ],
      "caption": "根毛增大吸收面积，从土壤中吸收水和无机盐"
    },
    {
      "name": "导管：水怎么上去",
      "say": "水从根到叶，走的是<b>导管</b>——位于木质部、上下贯通的一串死细胞。",
      "stats": [
        {
          "v": "导管",
          "label": "运水和无机盐"
        },
        {
          "v": "筛管",
          "label": "运有机物"
        },
        {
          "v": "向上",
          "label": "水的方向"
        }
      ],
      "ask": "对比记：<b>导管运水和无机盐（向上），筛管运有机物（向下）</b>。两套管道，别互换。",
      "note": "水能上升到几十米高的树顶，靠的是<b>蒸腾拉力</b>——叶在失水，水就被「拉」上来。",
      "parts": [
        "stem",
        "vessel"
      ],
      "routes": [
        "absorb",
        "rise"
      ],
      "caption": "导管位于木质部，运输水和无机盐，方向自下而上"
    },
    {
      "name": "气孔：水从哪里出去",
      "say": "水蒸气从<b>气孔</b>散失。气孔由两个<b>保卫细胞</b>围成，是叶片上的「门」。",
      "stats": [
        {
          "v": "2 个",
          "label": "保卫细胞"
        },
        {
          "v": "下表皮",
          "label": "气孔主要分布"
        },
        {
          "v": "共用",
          "label": "蒸腾与气体交换"
        }
      ],
      "ask": "保卫细胞吸水膨胀 → 气孔张开；失水收缩 → 气孔关闭。所以植物能自己决定什么时候「放水」。",
      "note": "气孔既是<b>蒸腾失水</b>的门，也是<b>二氧化碳进、氧气出</b>的门——同一扇门，两件事共用。",
      "parts": [
        "leaf",
        "stoma",
        "guard"
      ],
      "routes": [
        "rise",
        "transpire"
      ],
      "caption": "气孔由两个保卫细胞围成，是水蒸气出去的门户"
    },
    {
      "name": "蒸腾作用有什么用",
      "say": "蒸腾作用<b>不是浪费水</b>。它至少干三件事，每一件都不可替代。",
      "stats": [
        {
          "v": "拉力",
          "label": "把水拉上来"
        },
        {
          "v": "降温",
          "label": "保护叶片"
        },
        {
          "v": "水循环",
          "label": "参与自然界"
        }
      ],
      "ask": "① 产生蒸腾拉力，把水和无机盐从根拉到叶；② 降低叶片温度，夏天不至于被晒伤；③ 把水送回大气，参与生物圈的水循环。",
      "note": "记住因果链：<b>蒸腾失水 → 产生拉力 → 水和无机盐被拉上来</b>。没有蒸腾，根吸的水上不去。",
      "parts": [
        "leaf",
        "stoma"
      ],
      "routes": [
        "absorb",
        "rise",
        "transpire"
      ],
      "caption": "蒸腾作用：提供拉力、降低叶温、参与水循环"
    }
  ]
}
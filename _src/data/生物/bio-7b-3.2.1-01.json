  "legend": [
    {
      "color": "#3f7fc0",
      "text": "水（及溶解在水里的无机盐）"
    },
    {
      "color": "#6f9c4a",
      "text": "植物体"
    }
  ],
  "parts": [
    {
      "id": "root_hair",
      "name": "根毛",
      "en": "root hair",
      "only": "增大吸收面积",
      "desc": "根尖成熟区表皮细胞向外突起形成的细毛，数量极多。",
      "role": "吸收水和无机盐。根毛让根的表面积增大很多倍，吸水才够快。",
      "warn": "根毛不是「根的分支」，是单个表皮细胞伸出去的一根突起——所以它极细、极易在移栽时损伤。"
    },
    {
      "id": "root",
      "name": "根",
      "en": "root",
      "only": "吸水的主要部位",
      "desc": "植物体在地下部分，主根上分出许多侧根。",
      "role": "从土壤中吸收水和无机盐，并把植物体固定在土壤里。",
      "warn": "根吸收的是<b>水和无机盐</b>，有机物是叶片光合作用制造的——根不吸收有机物。"
    },
    {
      "id": "stem",
      "name": "茎",
      "en": "stem",
      "only": "运输通道",
      "desc": "连接根和叶的部分，里面有维管束。",
      "role": "支持叶、花、果实，同时把根吸来的水向上运、把叶制造的有机物向下运。",
      "warn": "上行和下行走的是<b>两套不同的管道</b>：水和无机盐走导管，有机物走筛管。"
    },
    {
      "id": "vessel",
      "name": "导管",
      "en": "vessel",
      "only": "运输水和无机盐（向上）",
      "desc": "位于茎的木质部里，是一串上下贯通的死细胞连成的细管。",
      "role": "把根吸收的水和无机盐，自下而上运到茎、叶、花、果实。蒸腾作用产生的拉力是水上升的主要动力。",
      "warn": "这是本节第一大坑：<b>导管运水和无机盐，筛管运有机物</b>。两者不要互换。"
    },
    {
      "id": "leaf",
      "name": "叶",
      "en": "leaf",
      "only": "蒸腾作用的主要器官",
      "desc": "植物进行光合作用的主要器官，表面分布着大量气孔。",
      "role": "蒸腾作用主要通过叶片进行——叶面积大、气孔多，水蒸气从这里大量散失。",
      "warn": "蒸腾作用不是「浪费水」。它拉动水和无机盐上升、降低叶片温度，是植物必需的生理活动。"
    },
    {
      "id": "stoma",
      "name": "气孔",
      "en": "stoma",
      "only": "水蒸气出去的门",
      "desc": "由两个保卫细胞围成的一个空隙，多分布在叶片的下表皮。",
      "role": "蒸腾失水的门户，也是二氧化碳进入、氧气出去的门户——气体交换和蒸腾共用这一个口。",
      "warn": "气孔既是「蒸腾的门」也是「气体交换的门」，同一扇门干两件事。"
    },
    {
      "id": "guard",
      "name": "保卫细胞",
      "en": "guard cell",
      "only": "控制气孔开闭",
      "desc": "围成气孔的两个半月形细胞，内含叶绿体。",
      "role": "吸水膨胀时气孔张开，失水收缩时气孔关闭。植物靠它决定「什么时候放水、什么时候憋住」。",
      "warn": "保卫细胞是<b>两个细胞</b>，气孔是它们<b>中间的空隙</b>——别把气孔说成一个细胞。"
    }
  ],

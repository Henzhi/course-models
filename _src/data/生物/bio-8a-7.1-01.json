  "legend": [
    {
      "color": "#c0392b",
      "text": "病原体 / 传播路径"
    },
    {
      "color": "#2f7d5c",
      "text": "阻断措施"
    }
  ],
  "parts": [
    {
      "id": "source",
      "name": "传染源",
      "en": "source of infection",
      "only": "能散播病原体的人或动物",
      "desc": "体内有病原体生长繁殖、并能把病原体排出体外的人或动物（病人、病原体携带者、患病动物）。",
      "role": "传染病流行的<b>起点</b>：病原体从这里出来，才能传给下一个人。",
      "warn": "传染源是<b>人或动物</b>，不是病原体。细菌、病毒叫「病原体」，它们不是传染源。"
    },
    {
      "id": "route_air",
      "name": "空气传播",
      "en": "airborne",
      "only": "飞沫、尘埃",
      "desc": "病人咳嗽、打喷嚏、说话时喷出的飞沫，或附着在尘埃上的病原体。",
      "role": "病原体随飞沫进入空气，被健康人吸入而感染。流感、肺结核走这条路。",
      "warn": "戴口罩挡住的是<b>这一环</b>——切断传播途径，不是控制传染源。"
    },
    {
      "id": "route_contact",
      "name": "接触传播",
      "en": "contact",
      "only": "直接或间接接触",
      "desc": "握手、拥抱等直接接触，或接触被污染的物品、用具。",
      "role": "病原体通过皮肤、黏膜的接触面进入健康人体内。",
      "warn": "「勤洗手」防的是接触传播，属于<b>切断传播途径</b>。"
    },
    {
      "id": "route_food",
      "name": "饮食传播",
      "en": "foodborne",
      "only": "食物和水",
      "desc": "被病原体污染的食物、饮用水。",
      "role": "病原体随食物、水进入消化道，引起肠道传染病（如痢疾、霍乱）。",
      "warn": "「不喝生水、饭前便后洗手」都是切断这一环。"
    },
    {
      "id": "crowd",
      "name": "易感人群",
      "en": "susceptible population",
      "only": "缺乏免疫力的人",
      "desc": "对某种传染病缺乏免疫力、容易感染该病的人群。",
      "role": "传染病流行的<b>终点</b>：病原体到达这里，才可能形成新的病人。",
      "warn": "易感是<b>针对某一种病</b>说的。得过麻疹的人对麻疹不易感，但对流感照样易感。"
    },
    {
      "id": "block_source",
      "name": "控制传染源",
      "en": "control the source",
      "only": "隔离、治疗、处理病畜",
      "desc": "把传染源与健康人分开，或消除其传染性。",
      "role": "具体做法：隔离病人、治疗病人、捕杀或处理患病动物、对携带者进行管理。",
      "warn": "「隔离病人」是<b>控制传染源</b>，不是「切断传播途径」——这是本节最高频的错。"
    },
    {
      "id": "block_route",
      "name": "切断传播途径",
      "en": "cut the route",
      "only": "消毒、戴口罩、洗手",
      "desc": "在病原体从传染源到易感人群的路上设卡。",
      "role": "具体做法：消毒、通风、戴口罩、勤洗手、消灭蚊蝇等媒介生物、处理污水垃圾。",
      "warn": "消毒、戴口罩、洗手、通风、灭蚊——这些都属于<b>切断传播途径</b>。"
    },
    {
      "id": "block_crowd",
      "name": "保护易感人群",
      "en": "protect the susceptible",
      "only": "接种疫苗、锻炼身体",
      "desc": "提高易感人群的抵抗力，或让他们不接触病原体。",
      "role": "具体做法：接种疫苗（最重要）、体育锻炼、合理营养、在传染病流行期间避免去人群密集场所。",
      "warn": "「接种疫苗」是<b>保护易感人群</b>，不是「控制传染源」——疫苗打在健康人身上。"
    }
  ],

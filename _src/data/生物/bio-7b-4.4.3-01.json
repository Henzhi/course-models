      "text": "动脉血（含氧多）"
    },
    {
      "color": "#3f66c8",
      "text": "静脉血（含氧少）"
    }
  ],
  "parts": [
    {
      "id": "ra",
      "name": "右心房",
      "en": "right atrium",
      "only": "接收全身的血",
      "desc": "心脏左上方的腔（图左侧）。上、下腔静脉把全身各处回来的血送到这里。",
      "role": "接收全身组织用完氧的血，再送进右心室。这里的血含氧少，是静脉血。",
      "warn": "右心房是体循环的终点。肺循环的终点是左心房，不是这里。"
    },
    {
      "id": "rv",
      "name": "右心室",
      "en": "right ventricle",
      "only": "肺循环的起点",
      "desc": "右心房下方（图左下）的腔，壁比左心室薄。",
      "role": "收缩时把血泵进肺动脉，送到肺里去换气。肺循环从这里出发。",
      "warn": "肺循环的起点是右心室，终点是左心房——起点在心室、终点在心房。"
    },
    {
      "id": "la",
      "name": "左心房",
      "en": "left atrium",
      "only": "肺循环的终点",
      "desc": "心脏右上方（图右侧）的腔，和肺静脉相连。",
      "role": "接收肺里换好气的血，再送进左心室。这里的血含氧多，是动脉血。",
      "warn": "肺静脉里流的是动脉血——血管名字叫「静脉」，血却是动脉血。这是本节第一大坑。"
    },
    {
      "id": "lv",
      "name": "左心室",
      "en": "left ventricle",
      "only": "体循环的起点",
      "desc": "左心房下方的腔（图右下），四个腔里壁最厚的一个。",
      "role": "收缩时把血泵进主动脉，送到全身。因为要把血送到全身，路径最长，所以壁最厚、力量最大。",
      "warn": "「左心室壁最厚」考的是原因：路程最远，需要最大压力。不要只背结论。"
    },
    {
      "id": "valve",
      "name": "瓣膜",
      "en": "valve",
      "only": "防止倒流",
      "desc": "心房和心室之间、心室和动脉之间的膜状结构，像单向门。",
      "role": "只允许血液朝一个方向走：心房 → 心室 → 动脉。心室收缩时，瓣膜关闭，血不会倒回心房。",
      "warn": "瓣膜保证血液单向流动。心跳的「咚」声，一部分就是瓣膜关闭造成的。"
    },
    {
      "id": "lung",
      "name": "肺",
      "en": "lung",
      "only": "静脉血 → 动脉血",
      "desc": "心脏上方的两个器官，里面有大量肺泡，外面缠满毛细血管。",
      "role": "气体交换站。血液在这里放出二氧化碳、获得氧气，于是从静脉血变成动脉血。",
      "warn": "这是全身唯一「静脉血变动脉血」的地方；相反方向的变化发生在全身组织。"
    },
    {
      "id": "body",
      "name": "全身组织",
      "en": "body tissue",
      "only": "动脉血 → 静脉血",
      "desc": "头、四肢、内脏等全身各处的组织和毛细血管网。",
      "role": "氧气和养料在这里交给组织细胞，二氧化碳等废物被带走。血就从动脉血变成了静脉血。",
      "warn": "组织处是「动脉血变成静脉血」，肺里是「静脉血变成动脉血」——两个方向别搞反。"
    }
  ],

  "steps": [
    {
      "name": "四个腔与瓣膜",
      "say": "心脏就是一台<b>双泵</b>：右边一半把血送到肺，左边一半把血送到全身。先认清四个腔。",
      "stats": [
        {
          "v": "4",
          "label": "个腔"
        },
        {
          "v": "2",
          "label": "条循环"
        },
        {
          "v": "单向",
          "label": "血流方向"
        }
      ],
      "ask": "点图中任意一个腔，看它接收谁的血、又泵到哪里去。注意中间那道隔板把左右两半完全分开——左半边和右半边的血不会直接混。",
      "note": "血流只有一个方向：<b>心房 → 心室 → 动脉</b>。瓣膜就是这个方向的「单向门」。",
      "parts": [
        "ra",
        "rv",
        "la",
        "lv",
        "valve"
      ],
      "routes": [],
      "caption": "右心房、右心室在图的左侧；左心房、左心室在图的右侧"
    },
    {
      "name": "肺循环",
      "say": "<b>右心室 → 肺动脉 → 肺 → 肺静脉 → 左心房。</b>这条路短，只负责「去肺里换气」。",
      "stats": [
        {
          "v": "右心室",
          "label": "起点"
        },
        {
          "v": "左心房",
          "label": "终点"
        },
        {
          "v": "静脉→动脉",
          "label": "血的变化"
        }
      ],
      "ask": "盯住白色的小球：它从右心室出发，沿<b>蓝色</b>的肺动脉进肺；回来时走的是<b>红色</b>的肺静脉。同一趟路，血的颜色变了。",
      "note": "肺静脉里是<b>动脉血</b>——名字叫静脉，血却是含氧多的动脉血。这是考试第一大坑。",
      "parts": [
        "rv",
        "la",
        "lung"
      ],
      "routes": [
        "pa",
        "pv"
      ],
      "caption": "肺循环：右心室 → 肺动脉 → 肺 → 肺静脉 → 左心房"
    },
    {
      "name": "体循环",
      "say": "<b>左心室 → 主动脉 → 全身组织 → 上、下腔静脉 → 右心房。</b>这条路长，负责把氧送到全身。",
      "stats": [
        {
          "v": "左心室",
          "label": "起点"
        },
        {
          "v": "右心房",
          "label": "终点"
        },
        {
          "v": "动脉→静脉",
          "label": "血的变化"
        }
      ],
      "ask": "这次从左边出发：红色主动脉一路向下到全身组织，回来走蓝色的腔静脉。<b>左心室壁最厚</b>，就是因为这条路最长。",
      "note": "动脉血变成静脉血发生在<b>组织处</b>：氧气被细胞拿走了。",
      "parts": [
        "lv",
        "ra",
        "body"
      ],
      "routes": [
        "sa",
        "sv"
      ],
      "caption": "体循环：左心室 → 主动脉 → 全身组织 → 上、下腔静脉 → 右心房"
    },
    {
      "name": "两条循环怎么接力",
      "say": "两条循环<b>不是各走各的</b>——它们在心脏里首尾相接，拼成一个「8」字。",
      "stats": [
        {
          "v": "8 字",
          "label": "整体形状"
        },
        {
          "v": "同时",
          "label": "两条一起流"
        }
      ],
      "ask": "看四条路同时流动。找两个接点：<b>右心室</b>接上肺循环，<b>左心室</b>接上体循环；回来的血分别进左心房、右心房。图上两条蓝色血管在心脏左侧交叉——它们在解剖上确实是前后交错的，不是同一条。",
      "note": "记忆口诀：<b>室出发、房回来</b>。肺循环「右室出、左房回」，体循环「左室出、右房回」。",
      "parts": [
        "ra",
        "rv",
        "la",
        "lv"
      ],
      "routes": [
        "pa",
        "pv",
        "sa",
        "sv"
      ],
      "caption": "两条循环在心脏里首尾相接：心室出发，心房回来"
    },
    {
      "name": "血在哪变色",
      "say": "全身只有<b>两个地方</b>能让血变色。找出来，这一节就不会再错了。",
      "stats": [
        {
          "v": "2 处",
          "label": "变色地点"
        },
        {
          "v": "含氧量",
          "label": "唯一判据"
        }
      ],
      "ask": "① <b>肺</b>：拿到氧气 → 静脉血变动脉血；② <b>全身组织</b>：交出氧气 → 动脉血变静脉血。",
      "note": "判断动脉血还是静脉血，只看<b>含氧量</b>，不看血管叫什么名字。",
      "parts": [
        "lung",
        "body"
      ],
      "routes": [
        "pa",
        "pv",
        "sa",
        "sv"
      ],
      "caption": "变色只发生在肺（静脉→动脉）和全身组织（动脉→静脉）"
    }
  ]
}
  "parts": [
    {
      "id": "chrom",
      "name": "染色体",
      "en": "chromosome",
      "only": "细胞核内",
      "desc": "由 DNA 和蛋白质组成的结构，是遗传物质的载体。人的体细胞里有 23 对。",
      "role": "基因就坐在染色体上——染色体成对，基因也成对；染色体减半，基因也减半。",
      "warn": "染色体不等于基因。染色体是「车」，基因是车上的一段「货」。"
    },
    {
      "id": "gene",
      "name": "基因",
      "en": "gene",
      "only": "DNA 上的一段",
      "desc": "有遗传效应的 DNA 片段，控制生物的性状。体细胞中成对存在。",
      "role": "亲代传给子代的是基因，不是性状。",
      "warn": "「父母把性状传给孩子」是错的判断题——传的是基因，性状在子代身上重新表达。"
    },
    {
      "id": "dadcell",
      "name": "父方体细胞",
      "en": "somatic cell",
      "only": "2n，成对",
      "desc": "含 2 对（4 条）染色体，每对里一条来自祖父、一条来自祖母。人体细胞是 23 对。",
      "role": "形成精子时，每对只交出一条。",
      "warn": "体细胞中染色体成对，这一点和生殖细胞正相反。"
    },
    {
      "id": "momcell",
      "name": "母方体细胞",
      "en": "somatic cell",
      "only": "2n，成对",
      "desc": "同样含 2 对染色体，用红色表示母方来源。",
      "role": "形成卵细胞时，每对只交出一条。",
      "warn": "母方的贡献和父方一样多——各给一半，没有谁「主要像谁」。"
    },
    {
      "id": "sperm",
      "name": "精子",
      "en": "sperm",
      "only": "n，成单",
      "desc": "染色体数减半，人的精子有 23 条，且互不成对。",
      "role": "基因传递的桥梁之一。",
      "warn": "精子里的染色体不成对，所以没有「一对基因」的说法。"
    },
    {
      "id": "egg",
      "name": "卵细胞",
      "en": "ovum",
      "only": "n，成单",
      "desc": "染色体数减半，人的卵细胞有 23 条。",
      "role": "桥梁的另一半。",
      "warn": "一个卵细胞只能与一个精子结合，所以子代只有两个亲本。"
    },
    {
      "id": "zygote",
      "name": "受精卵",
      "en": "zygote",
      "only": "2n，恢复成对",
      "desc": "精子与卵细胞结合而成，染色体恢复成对：一半来自父方、一半来自母方。",
      "role": "发育成新个体的起点。",
      "warn": "受精卵的染色体数与体细胞相同（46 条），不是父母相加的 92 条。"
    },
    {
      "id": "offspring",
      "name": "子代",
      "en": "offspring",
      "only": "2n",
      "desc": "由受精卵发育而成的新个体。每一对基因都是一半来自父亲、一半来自母亲。",
      "role": "既像父亲又像母亲，原因就在这里。",
      "warn": "同一对父母的后代不会完全相同——每次受精拿到的组合都可能不一样。"
    }
  ]
}
  "steps": [
    {
      "name": "基因坐在染色体上",
      "say": "先看清「东西放在哪」——基因不是飘在细胞里的，它坐在染色体上。",
      "stats": [
        {
          "v": "4",
          "label": "体细胞染色体（2 对）"
        }
      ],
      "ask": "数一数左上那个细胞里有几根染色体？为什么是 4 根、不是 2 根？",
      "note": "<b>体细胞里染色体成对存在，基因也成对存在。</b>一根来自父方、一根来自母方，配成一对。染色体由 DNA 和蛋白质组成，基因是有遗传效应的 DNA 片段。",
      "parts": [
        "dadcell",
        "momcell",
        "chrom",
        "gene"
      ],
      "routes": [],
      "caption": "染色体成对存在 → 基因也成对存在"
    },
    {
      "name": "形成生殖细胞：每对只走一条",
      "say": "形成精子或卵细胞时，每一对染色体只挑一条进去——所以染色体数目减半。",
      "stats": [
        {
          "v": "2",
          "label": "精子 / 卵细胞（每对一条）"
        }
      ],
      "ask": "4 根变成 2 根，少的那两根去哪了？如果这一步不减半，会出什么问题？",
      "note": "<b>每对染色体各有一条进入生殖细胞</b>，所以精子、卵细胞的染色体数是体细胞的一半，基因也随之减半（成单，不再成对）。",
      "parts": [
        "dadcell",
        "momcell",
        "sperm",
        "egg",
        "chrom"
      ],
      "routes": [
        "r_dad",
        "r_mom"
      ],
      "caption": "减半：4 → 2，且这 2 条互不成对"
    },
    {
      "name": "受精：两半合成一份",
      "say": "精子与卵细胞结合成受精卵，两半合在一起，染色体的数目又恢复成对。",
      "stats": [
        {
          "v": "4",
          "label": "受精卵（2 对，父母各 2）"
        }
      ],
      "ask": "受精卵里的 4 根染色体，哪两根算「一对」？看颜色。",
      "note": "<b>受精卵中成对的染色体，一条来自父方、一条来自母方。</b>注意数目：不是 46 + 46 = 92，而是 23 + 23 = 46，<b>与体细胞相同</b>。",
      "parts": [
        "sperm",
        "egg",
        "zygote",
        "chrom",
        "gene"
      ],
      "routes": [
        "r_fert1",
        "r_fert2"
      ],
      "caption": "恢复成对：2 + 2 = 4（不是 2 × 2 = 4）"
    },
    {
      "name": "桥的两头：传的是基因",
      "say": "整条路上，真正把东西送过去的是精子和卵细胞。",
      "stats": [
        {
          "v": "基因",
          "label": "传下去的东西"
        },
        {
          "v": "精子·卵细胞",
          "label": "传递的桥梁"
        }
      ],
      "ask": "父母把「双眼皮」直接传给孩子了吗？还是传了别的东西？",
      "note": "<b>亲代传给子代的是基因，不是性状。</b>性状是基因在子代身上重新表达出来的结果。精子和卵细胞就是基因在亲子代间传递的<b>桥梁</b>。",
      "parts": [
        "sperm",
        "egg",
        "zygote",
        "offspring"
      ],
      "routes": [
        "r_dad",
        "r_mom",
        "r_fert1",
        "r_fert2",
        "r_off"
      ],
      "caption": "桥梁：精子与卵细胞"
    },
    {
      "name": "数一数：46 → 23 → 46",
      "say": "人身上的这套数字，是每年必考的。",
      "ask": "为什么生殖细胞的染色体数正好是体细胞的一半？这条链里哪一步最关键？",
      "note": "一句话记：<b>成对 → 减半 → 恢复成对</b>。数字可以忘，这条链不能忘。",
      "table": {
        "head": [
          "",
          "体细胞",
          "生殖细胞",
          "受精卵"
        ],
        "rows": [
          [
            "人的染色体",
            "23 对（46 条）",
            "23 条",
            "23 对（46 条）"
          ],
          [
            "基因",
            "成对",
            "成单",
            "成对"
          ]
        ]
      },
      "parts": [
        "zygote",
        "offspring"
      ],
      "routes": [
        "r_off"
      ],
      "caption": "成对 → 减半 → 恢复成对"
    }
  ],

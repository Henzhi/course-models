{
  "canvas": {
    "w": 900,
    "h": 560
  },
  "hero": {
    "title": "肺泡：一次交换，只隔两层细胞",
    "goal": "肺泡里的氧气比血液里多，血液里的二氧化碳比肺泡里多——所以氧气自己往血里走，二氧化碳自己往肺泡里走。这叫扩散，不靠「吸」。",
    "tips": [
      "先点「结构基础」：看清肺泡壁和毛细血管壁各只有一层细胞",
      "再点「气体怎么走」：两个箭头方向相反，原因只有一个——浓度差",
      "注意箭头是「自己走」的，肺没有把氧气「抽」进血液"
    ]
  },
  "groups": [
    {
      "label": "两层壁",
      "title": "为什么能交换：只隔两层细胞",
      "lead": "气体要过的「墙」只有两堵：肺泡壁、毛细血管壁，各一层细胞。",
      "items": "肺泡壁 · 毛细血管壁",
      "tip": "两层都只有一层细胞——这是肺泡适于气体交换最关键的结构特点，也是常考原话。",
      "ids": [
        "wall",
        "capillary"
      ]
    },
    {
      "label": "氧气方向",
      "title": "氧气：肺泡 → 血液",
      "lead": "肺泡里氧气多，血液里氧气少，所以氧气自己往血液里走，被红细胞装走。",
      "items": "氧气扩散 · 红细胞",
      "tip": "不是肺把氧气「吸」进血液。肺只负责让空气进出，进血液靠扩散。",
      "ids": [
        "o2",
        "rbc"
      ]
    },
    {
      "label": "二氧化碳方向",
      "title": "二氧化碳：血液 → 肺泡",
      "lead": "血液里二氧化碳多，肺泡里少，所以二氧化碳往肺泡里走，随呼气排出。",
      "items": "二氧化碳扩散",
      "tip": "两个方向同时发生，不是「先吸氧、再排二氧化碳」。",
      "ids": [
        "co2"
      ]
    }
  ],
  "parts": [
    {
      "id": "alveolus",
      "name": "肺泡",
      "en": "alveolus",
      "only": "气体交换的场所",
      "desc": "肺里像小气球一样的囊泡，数量极多（成人约 3 亿个），里面装着吸入的空气。",
      "role": "气体交换的场所。空气中的氧气在这里进入血液，血液里的二氧化碳在这里排出去。",
      "warn": "肺泡不是「一个一个分开工作」的——它们数量极多、总面积很大（约 70 平方米），才够全身用。"
    },
    {
      "id": "wall",
      "name": "肺泡壁",
      "en": "alveolar wall",
      "only": "只有一层细胞",
      "desc": "肺泡最外面的一层扁平细胞。",
      "role": "极薄，气体容易穿过。这是「适合气体交换」的第一个结构特点。",
      "warn": "肺泡壁只有<b>一层</b>细胞——不是「很薄的一层组织」，就是一层细胞。这是常考原话。"
    },
    {
      "id": "capillary",
      "name": "毛细血管",
      "en": "capillary",
      "only": "紧贴肺泡，也只有一层细胞",
      "desc": "缠绕在肺泡外面的极细血管，管壁只有一层细胞，血流很慢。",
      "role": "把血液送到肺泡旁边。管壁薄、血流慢，给气体交换留出时间。",
      "warn": "毛细血管壁同样只有一层细胞。两层细胞加起来，气体只走极短的一段距离。"
    },
    {
      "id": "rbc",
      "name": "红细胞",
      "en": "red blood cell",
      "only": "运氧的主力",
      "desc": "血液里数量最多的血细胞，里面有一种红色的蛋白质，专门和氧结合。",
      "role": "把进入血液的氧气装走，运到全身各处。红细胞里的血红蛋白是氧气的主要携带者。",
      "warn": "氧气进入血液后，绝大部分是由红细胞装的，不是「溶在血浆里」。"
    },
    {
      "id": "o2",
      "name": "氧气扩散（O₂）",
      "en": "oxygen diffusion",
      "only": "肺泡 → 血液",
      "desc": "氧气从肺泡穿过肺泡壁和毛细血管壁，进入血液。",
      "role": "因为肺泡里氧气多、血液里氧气少，氧气就自己往血液里走。这就是扩散。",
      "warn": "不是肺「把氧气吸进血液」。肺只负责让空气进出，氧气进血液靠的是<b>扩散</b>。"
    },
    {
      "id": "co2",
      "name": "二氧化碳扩散（CO₂）",
      "en": "carbon dioxide diffusion",
      "only": "血液 → 肺泡",
      "desc": "二氧化碳从血液穿过两层壁，进入肺泡，随呼气排出体外。",
      "role": "因为血液里二氧化碳多、肺泡里少，二氧化碳就往肺泡里走，方向正好和氧气相反。",
      "warn": "两个方向同时发生，不是「先吸氧再排二氧化碳」。一次呼吸，两件事一起完成。"
    }
  ],

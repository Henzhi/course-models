  "steps": [
    {
      "name": "一朵花里的两性",
      "say": "一朵花里最重要的是两部分：雌蕊和雄蕊。它们分别产生卵细胞和精子。",
      "stats": [
        {
          "v": "雌蕊",
          "label": "柱头 · 花柱 · 子房"
        },
        {
          "v": "雄蕊",
          "label": "花药 · 花丝"
        }
      ],
      "ask": "数一数：这朵花里有几个子房？子房里面又有什么？",
      "note": "<b>雌蕊由柱头、花柱、子房三部分组成，子房里有胚珠。</b>雄蕊的花药里产生花粉，花粉里有精子——初中只需知道「花粉里有精子」。",
      "parts": [
        "stigma",
        "style",
        "ovary",
        "ovule",
        "anther",
        "filament"
      ],
      "routes": [],
      "caption": "雌蕊（子房里有胚珠）+ 雄蕊（花药里有花粉）"
    },
    {
      "name": "传粉：从花药到柱头",
      "say": "花药成熟后裂开，花粉落到柱头上，这个过程叫传粉。",
      "stats": [
        {
          "v": "传粉",
          "label": "花粉 → 柱头"
        }
      ],
      "ask": "如果花粉落在同一朵花的柱头上，还算传粉吗？",
      "note": "传粉分两种：<b>自花传粉</b>（同一朵花）和<b>异花传粉</b>（不同花之间，靠风或昆虫）。<b>异花传粉的后代变异更丰富</b>，这也是多数植物开花的原因。",
      "parts": [
        "anther",
        "stigma",
        "style",
        "ovary"
      ],
      "routes": [
        "r_pollinate"
      ],
      "caption": "传粉：花粉从花药落到柱头"
    },
    {
      "name": "花粉管：把精子送下去",
      "say": "花粉在柱头上萌发，长出一根花粉管，沿花柱一直向下，穿过子房壁，到达胚珠。",
      "stats": [
        {
          "v": "受精",
          "label": "精子 + 卵细胞"
        }
      ],
      "ask": "精子会自己游过去吗？为什么非要靠一根「管子」？",
      "note": "精子不能自己移动，<b>靠花粉管送进胚珠</b>。到达后，精子与卵细胞结合形成<b>受精卵</b>——这一步是「有性生殖」成立的关键。",
      "parts": [
        "stigma",
        "style",
        "ovary",
        "ovule"
      ],
      "routes": [
        "r_tube"
      ],
      "caption": "花粉管沿花柱向下，精子与卵细胞结合成受精卵"
    },
    {
      "name": "子房变果实",
      "say": "受精之后，花瓣、雄蕊都凋落了，只有子房继续发育——它变成整个果实。",
      "stats": [
        {
          "v": "子房",
          "label": "→ 整个果实"
        },
        {
          "v": "胚珠",
          "label": "→ 每粒种子"
        }
      ],
      "ask": "我们吃的桃，哪一层是「子房壁」变来的？哪部分是「胚珠」变来的？",
      "note": "<b>子房壁 → 果皮，胚珠 → 种子。</b>看颜色：粉色变粉色，棕色变棕色。<br>果实里有几粒种子，取决于原子房里的胚珠数。",
      "parts": [
        "ovary",
        "ovule",
        "pericarp",
        "seed"
      ],
      "routes": [
        "r_dev"
      ],
      "caption": "子房壁 → 果皮；胚珠 → 种子"
    },
    {
      "name": "有性生殖的意义",
      "say": "精子与卵细胞结合成受精卵，再由受精卵发育成新个体——这种方式叫有性生殖。",
      "ask": "扦插、嫁接也能繁殖，为什么大多数植物还要「开花结果」？",
      "table": {
        "head": [
          "",
          "有性生殖",
          "无性生殖"
        ],
        "rows": [
          [
            "生殖细胞结合",
            "有（精子 + 卵细胞）",
            "没有"
          ],
          [
            "后代特点",
            "具双亲特性，变异多",
            "与亲代几乎相同"
          ],
          [
            "例子",
            "种子繁殖、动物繁殖",
            "扦插、嫁接、分裂"
          ]
        ]
      },
      "note": "后代<b>同时具有两个亲本的遗传特性</b>，变异更丰富，<b>适应环境变化的能力更强</b>。",
      "parts": [
        "ovary",
        "ovule",
        "pericarp",
        "seed"
      ],
      "routes": [
        "r_dev"
      ],
      "caption": "有性生殖：两个亲本参与，后代变异丰富"
    }
  ],

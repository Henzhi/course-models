  "parts": [
    {
      "id": "stigma",
      "name": "柱头",
      "en": "stigma",
      "only": "雌蕊顶端",
      "desc": "接受花粉的地方，常有黏液帮助花粉附着。",
      "role": "传粉的落脚点，花粉管从这里开始长。",
      "warn": "柱头不是「花心」，它是雌蕊最顶端专门接花粉的部位。"
    },
    {
      "id": "style",
      "name": "花柱",
      "en": "style",
      "only": "雌蕊中段",
      "desc": "连接柱头和子房的细长部分。",
      "role": "花粉管沿花柱向下生长，把精子送到子房。",
      "warn": "花粉管是花粉长出来的，不是花柱本身的一部分。"
    },
    {
      "id": "ovary",
      "name": "子房",
      "en": "ovary",
      "only": "雌蕊基部",
      "desc": "膨大的部分，外壁是子房壁，里面有胚珠。",
      "role": "受精后发育成果实，子房壁变成果皮。",
      "warn": "果实不是「子房里的胚珠变的」——整个果实来自子房，种子才来自胚珠。"
    },
    {
      "id": "ovule",
      "name": "胚珠",
      "en": "ovule",
      "only": "子房内",
      "desc": "子房里的小球状结构，内含卵细胞。",
      "role": "受精后发育成种子。",
      "warn": "胚珠的数量决定种子的数量：一个胚珠只能形成一粒种子。"
    },
    {
      "id": "anther",
      "name": "花药",
      "en": "anther",
      "only": "雄蕊顶端",
      "desc": "产生花粉的部位，成熟后裂开散出花粉。",
      "role": "花粉里含有精子，是传粉的起点。",
      "warn": "花粉不等于精子——花粉萌发后形成花粉管，里面才有精子。"
    },
    {
      "id": "filament",
      "name": "花丝",
      "en": "filament",
      "only": "雄蕊",
      "desc": "支撑花药的细丝。",
      "role": "把花药托到高处，便于散出花粉。",
      "warn": "花丝只起支撑作用，不产生花粉。"
    },
    {
      "id": "pericarp",
      "name": "果皮",
      "en": "pericarp",
      "only": "由子房壁发育",
      "desc": "果实的外层，由子房壁发育而来。",
      "role": "保护种子，也帮助种子传播。",
      "warn": "「果皮」不一定是薄薄一层——桃的果肉、西瓜瓤都属于果皮。"
    },
    {
      "id": "seed",
      "name": "种子",
      "en": "seed",
      "only": "由胚珠发育",
      "desc": "由胚珠发育而来，里面是受精卵发育成的胚。",
      "role": "新个体的起点。",
      "warn": "种子来自胚珠，不是来自子房壁——这两条对应关系必须分开记。"
    }
  ]
}
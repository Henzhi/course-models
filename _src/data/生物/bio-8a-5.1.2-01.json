{
  "canvas": {
    "w": 1000,
    "h": 692
  },
  "legend": [
    {
      "color": "#4c9a6a",
      "text": "物质与能量流动的方向"
    },
    {
      "color": "#c0392b",
      "text": "有毒物质富集（越往上越浓）"
    }
  ],
  "parts": [
    {
      "id": "grass",
      "name": "生产者",
      "en": "producer",
      "only": "绿色植物",
      "desc": "能进行光合作用、自己制造有机物的生物，主要是绿色植物。",
      "role": "把光能变成化学能，为整个生态系统提供有机物和能量的<b>源头</b>。",
      "warn": "食物链<b>必须从生产者开始</b>。没有草，就没有后面所有的动物。"
    },
    {
      "id": "rabbit",
      "name": "初级消费者",
      "en": "primary consumer",
      "only": "直接吃植物",
      "desc": "以生产者为食的动物，如兔、鼠、昆虫。",
      "role": "把生产者制造的有机物变成动物体的有机物，是食物链的第二环。",
      "warn": "初级消费者吃的是<b>植物</b>。它不叫「第一级」也不叫「二级」——按「第几营养级」数，它才是第二营养级。"
    },
    {
      "id": "fox",
      "name": "次级消费者",
      "en": "secondary consumer",
      "only": "吃初级消费者",
      "desc": "以初级消费者为食的动物，如狐、蛇、鸟。",
      "role": "处在食物链的第三环，营养级更高，获得的能量更少。",
      "warn": "营养级越高，<b>能量越少、数量通常也越少</b>——这就是能量金字塔下宽上窄的原因。"
    },
    {
      "id": "decomposer",
      "name": "分解者",
      "en": "decomposer",
      "only": "细菌和真菌",
      "desc": "营腐生生活的细菌和真菌（部分动物如蚯蚓也起分解作用）。",
      "role": "把动植物遗体和排泄物中的有机物分解成无机物，<b>归还</b>给无机环境，供生产者再利用。",
      "warn": "分解者<b>不写进食物链</b>。食物链写的是「谁吃谁」，分解者不吃活的生物。"
    },
    {
      "id": "abiotic",
      "name": "非生物部分",
      "en": "abiotic component",
      "only": "阳光、空气、水、温度",
      "desc": "生态系统中没有生命的部分。",
      "role": "为生物提供物质和能量：阳光是能量的最终来源，水和无机盐是光合作用的原料。",
      "warn": "非生物部分<b>也不是食物链的环节</b>，但它是生态系统不可缺少的组成。"
    },
    {
      "id": "pyramid",
      "name": "能量金字塔",
      "en": "energy pyramid",
      "only": "下宽上窄",
      "desc": "把各营养级所含的能量按顺序叠起来画成的图形。",
      "role": "能量沿食物链流动时<b>逐级递减</b>，每一级只有约 10%–20% 传给下一级。",
      "warn": "能量流动是<b>单向</b>的、<b>不能循环</b>的。这一点和物质循环正好相反。"
    },
    {
      "id": "bioacc",
      "name": "生物富集",
      "en": "biological magnification",
      "only": "越往上越浓",
      "desc": "有毒物质（如重金属、农药）沿食物链不断积累的现象。",
      "role": "有毒物质难分解、难排出，会随食物链<b>逐级增多</b>，营养级越高浓度越大。",
      "warn": "能量是<b>递减</b>的，有毒物质是<b>递增</b>的——两个方向正好相反，这是本节最容易记混的一对。"
    }
  ],

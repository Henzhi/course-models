  "steps": [
    {
      "name": "生态系统由四部分组成",
      "say": "生态系统 = <b>生物部分</b>（生产者、消费者、分解者）+ <b>非生物部分</b>（阳光、空气、水、温度）。四样缺一不可。",
      "stats": [
        {
          "v": "4 类",
          "label": "组成"
        },
        {
          "v": "光合作用",
          "label": "生产者的本事"
        },
        {
          "v": "细菌真菌",
          "label": "分解者主体"
        }
      ],
      "ask": "点图中的草、兔、狐、细菌真菌、太阳，看各自属于哪一类、起什么作用。",
      "note": "生产者是<b>源头</b>——它把光能变成化学能，后面所有生物的能量都从这里来。",
      "parts": [
        "grass",
        "rabbit",
        "fox",
        "decomposer",
        "abiotic"
      ],
      "routes": [],
      "caption": "生产者 + 消费者 + 分解者 + 非生物部分",
      "hide": [
        "bioacc"
      ]
    },
    {
      "name": "一条食物链",
      "say": "食物链写的是「<b>谁吃谁</b>」：草 → 兔 → 狐。箭头指向<b>捕食者</b>，也就是物质和能量流动的方向。",
      "stats": [
        {
          "v": "3 环",
          "label": "这条链"
        },
        {
          "v": "生产者",
          "label": "必须从它开始"
        },
        {
          "v": "指向捕食者",
          "label": "箭头方向"
        }
      ],
      "ask": "注意箭头是「草 → 兔」而不是「兔 → 草」：<b>箭头指向吃的一方</b>。这个方向记反，后面能量流动就全错了。",
      "note": "食物链<b>不从分解者开始、也不写分解者</b>，不写非生物部分。它只写「谁被谁吃」。",
      "parts": [
        "grass",
        "rabbit",
        "fox"
      ],
      "routes": [
        "c1a",
        "c1b"
      ],
      "caption": "草 → 兔 → 狐（箭头指向捕食者）",
      "hide": [
        "bioacc"
      ]
    },
    {
      "name": "多条链织成食物网",
      "say": "真实的生态系统里，一种生物往往不只吃一种、也不只被一种吃。多条食物链<b>交错连接</b>，就是食物网。",
      "stats": [
        {
          "v": "3 条",
          "label": "图中的链"
        },
        {
          "v": "交错",
          "label": "为什么叫网"
        },
        {
          "v": "越复杂越稳",
          "label": "一般规律"
        }
      ],
      "ask": "找一下蛇：它既吃鼠、又吃鸟——同一种动物可以在<b>不同的链</b>里处在不同位置。",
      "note": "食物网越复杂，生态系统的<b>自我调节能力越强</b>。某一种生物消失，还有别的路径替补。",
      "parts": [
        "grass",
        "rabbit",
        "fox"
      ],
      "routes": [
        "c1a",
        "c1b",
        "c2a",
        "c2b",
        "c3a",
        "c3b",
        "c4"
      ],
      "caption": "草 → 兔 → 狐 / 草 → 鼠 → 蛇 / 草 → 虫 → 鸟 → 蛇",
      "hide": [
        "bioacc"
      ]

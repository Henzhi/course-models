  "legend": [
    {
      "color": "#d24b4b",
      "text": "血液"
    },
    {
      "color": "#e0b06a",
      "text": "原尿 / 尿液"
    },
    {
      "color": "#4c9a6a",
      "text": "重吸收回血液"
    }
  ],
  "parts": [
    {
      "id": "glomerulus",
      "name": "肾小球",
      "en": "glomerulus",
      "only": "滤过的筛子",
      "desc": "入球小动脉分支形成的一团毛细血管球，被肾小囊包在里面。",
      "role": "血液流经这里时发生<b>滤过</b>：除血细胞和大分子蛋白质外，血浆中的水、无机盐、葡萄糖、尿素都滤到肾小囊里。",
      "warn": "肾小球像筛子，筛孔只挡「大个的」。血细胞和蛋白质过不去，所以正常尿液里没有它们。"
    },
    {
      "id": "capsule",
      "name": "肾小囊",
      "en": "renal capsule",
      "only": "接住滤出液",
      "desc": "包在肾小球外面的双层囊，内层紧贴血管球，两层之间是囊腔。",
      "role": "接住从肾小球滤出的液体，这部分液体叫<b>原尿</b>，再送进肾小管。",
      "warn": "原尿 ≠ 尿液。原尿里有葡萄糖，尿液里没有——差别就在下一步的重吸收。"
    },
    {
      "id": "tubule",
      "name": "肾小管",
      "en": "renal tubule",
      "only": "重吸收的主力",
      "desc": "从肾小囊延伸出来的一条细长弯曲的管子。",
      "role": "原尿流经这里时发生<b>重吸收</b>：全部葡萄糖、大部分水和部分无机盐被重新吸收回周围的毛细血管，剩下的才成为尿液。",
      "warn": "尿里出现葡萄糖，说明<b>肾小管</b>出了问题（重吸收不到位）；尿里出现蛋白质，说明<b>肾小球</b>出了问题。这两个部位别弄反。"
    },
    {
      "id": "capillary",
      "name": "肾小管周围毛细血管",
      "en": "peritubular capillary",
      "only": "把重吸收的东西带走",
      "desc": "缠绕在肾小管外面的毛细血管网，由出球小动脉分支形成。",
      "role": "接收肾小管重吸收回来的葡萄糖、水和无机盐，把它们送回血液循环。",
      "warn": "重吸收不是「把东西扔掉」，而是「把有用的捡回来」。所以这条管里流的是干净的血，不是尿。"
    },
    {
      "id": "collecting",
      "name": "集合管",
      "en": "collecting duct",
      "only": "尿液汇合",
      "desc": "多条肾小管汇入的管道。",
      "role": "把尿液汇集起来，流进肾盂，再由输尿管送走。",
      "warn": "肾单位只包括肾小球、肾小囊、肾小管三部分，<b>集合管不算肾单位</b>。"
    },
    {
      "id": "kidney",
      "name": "肾脏",
      "en": "kidney",
      "only": "形成尿液的器官",
      "desc": "腹腔内蚕豆形的一对器官，左右各一。",
      "role": "里面有一百多万个肾单位，尿液就在这里形成。",
      "warn": "肾脏是<b>形成</b>尿液的器官，膀胱是<b>暂时储存</b>尿液的器官——别把两者搞混。"
    },
    {
      "id": "ureter",
      "name": "输尿管",
      "en": "ureter",
      "only": "输送尿液",
      "desc": "从肾脏通向膀胱的两条细长管道。",
      "role": "把肾脏形成的尿液送到膀胱。",
      "warn": "输尿管输送的是<b>尿</b>，不是血。它和血管是两套系统。"
    },
    {
      "id": "bladder",
      "name": "膀胱",
      "en": "urinary bladder",
      "only": "暂时储存尿液",
      "desc": "盆腔内的囊状器官，有弹性。",
      "role": "暂时储存尿液，存到一定量时产生尿意，再经尿道排出。",
      "warn": "膀胱只<b>存</b>尿，不造尿。造尿的器官是肾脏。"
    },
    {
      "id": "urethra",
      "name": "尿道",
      "en": "urethra",
      "only": "排出尿液",
      "desc": "把膀胱里的尿液排出体外的管道。",
      "role": "尿液排出体外的最后一段通路。",
      "warn": "「排泄」指排出代谢废物（尿、汗、呼出的二氧化碳和水）；粪便排出叫「排遗」，不算排泄。"
    }
  ],

  "steps": [
    {
      "name": "先认路：泌尿系统",
      "say": "尿液从<b>肾脏</b>造出来，经<b>输尿管</b>送到<b>膀胱</b>暂存，最后由<b>尿道</b>排出。四个器官，一条单向通路。",
      "stats": [
        {
          "v": "4 个",
          "label": "器官"
        },
        {
          "v": "肾脏",
          "label": "造尿的"
        },
        {
          "v": "膀胱",
          "label": "只存不造"
        }
      ],
      "ask": "点左边那团结构和右边四个器官都看看。记住分工：<b>肾造尿、输尿管送尿、膀胱存尿、尿道排尿</b>。",
      "note": "「排泄」排的是<b>代谢废物</b>（尿、汗、呼出的二氧化碳和水）。粪便排出叫<b>排遗</b>，不算排泄。",
      "parts": [
        "kidney",
        "ureter",
        "bladder",
        "urethra"
      ],
      "routes": [
        "ureter",
        "urethra"
      ],
      "caption": "肾脏 → 输尿管 → 膀胱 → 尿道"
    },
    {
      "name": "肾单位：三个部件",
      "say": "尿液是在<b>肾单位</b>里造出来的。一个肾单位就三样：<b>肾小球、肾小囊、肾小管</b>。",
      "stats": [
        {
          "v": "3 个",
          "label": "部件"
        },
        {
          "v": "约 100 万",
          "label": "每个肾里"
        },
        {
          "v": "不含",
          "label": "集合管"
        }
      ],
      "ask": "看清包与被包的关系：<b>肾小球是一团毛细血管，被肾小囊包在里面</b>；肾小囊向下延伸成肾小管。",
      "note": "肾单位 = 肾小球 + 肾小囊 + 肾小管。<b>集合管不是肾单位的一部分</b>，它是多条肾小管汇合后的管道。",
      "parts": [
        "glomerulus",
        "capsule",
        "tubule"
      ],
      "routes": [],
      "caption": "肾单位：肾小球 + 肾小囊 + 肾小管"
    },
    {
      "name": "第一步：滤过（造原尿）",
      "say": "血液流经<b>肾小球</b>时被「筛」了一遍：<b>除血细胞和大分子蛋白质外</b>，水、无机盐、葡萄糖、尿素都滤到肾小囊里，形成<b>原尿</b>。",
      "stats": [
        {
          "v": "约 150 升",
          "label": "每天生成原尿"
        },
        {
          "v": "挡在外",
          "label": "血细胞、蛋白质"
        },
        {
          "v": "原尿",
          "label": "滤出的液体"
        }
      ],
      "ask": "肾小球像筛子，筛孔只挡「大个的」。所以红细胞和蛋白质过不去，原尿里没有它们。",
      "note": "原尿不是尿。此时葡萄糖、水、无机盐都还在里面——它们会在下一步被捡回去。",
      "parts": [
        "glomerulus",
        "capsule"
      ],
      "routes": [
        "blood",
        "filter"
      ],
      "caption": "滤过：血液 →（除血细胞、大分子蛋白质）→ 原尿"
    },
    {
      "name": "第二步：重吸收（变尿液）",
      "say": "原尿流经<b>肾小管</b>时，<b>全部葡萄糖、大部分水和部分无机盐</b>被重吸收回血液，剩下的才成为尿液。",
      "stats": [
        {
          "v": "150 → 1.5 升",
          "label": "原尿 → 尿"
        },
        {
          "v": "全部",
          "label": "葡萄糖被收回"
        },
        {
          "v": "约 99%",
          "label": "水被收回"
        }
      ],
      "ask": "绿色的小球是<b>被捡回去</b>的：从肾小管回到周围毛细血管。所以一天 150 升原尿，最后只排出约 1.5 升尿。",
      "note": "尿里出现<b>葡萄糖</b> → 肾小管出问题；尿里出现<b>蛋白质</b> → 肾小球出问题。这两个部位是本节最爱考的配对。",
      "parts": [
        "tubule",
        "capillary"
      ],
      "routes": [
        "filtrate",
        "reabsorb",
        "vena"
      ],
      "caption": "重吸收：葡萄糖全部、水大部分、无机盐部分 → 回血液"
    },
    {
      "name": "第三步：排出，并看成分",
      "say": "剩下的尿液经集合管 → 肾盂 → 输尿管 → 膀胱 → 尿道排出。三种液体的成分差别，一张表就能看清。",
      "stats": [
        {
          "v": "1.5 升",
          "label": "每天排尿"
        },
        {
          "v": "2 种",
          "label": "原尿有、尿没有"
        }
      ],
      "ask": "看表时问一句：如果尿里出现了蛋白质，是哪个环节坏了？如果出现了葡萄糖呢？——答案在上一页的两句话里。",
      "note": "排尿不只是排废物：它还<b>调节体内水和无机盐的平衡</b>，维持组织细胞的正常生理功能。",
      "parts": [
        "collecting",
        "ureter",
        "bladder",
        "urethra"
      ],

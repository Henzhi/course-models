  "parts": [
    {
      "id": "parent_tall",
      "name": "纯种高茎（DD）",
      "en": "homozygous",
      "only": "两个基因相同",
      "desc": "两条染色体上都是显性基因 D。",
      "role": "高茎是显性性状，纯种高茎只能产生含 D 的生殖细胞。",
      "warn": "「纯种」的意思是两个基因相同（DD 或 dd），不是「品种好」。"
    },
    {
      "id": "parent_short",
      "name": "纯种矮茎（dd）",
      "en": "homozygous",
      "only": "两个基因相同",
      "desc": "两条染色体上都是隐性基因 d。",
      "role": "矮茎是隐性性状，纯种矮茎只能产生含 d 的生殖细胞。",
      "warn": "隐性性状不是「没有基因」，而是两个基因都是隐性的。"
    },
    {
      "id": "gamete_D",
      "name": "含 D 的生殖细胞",
      "en": "gamete",
      "only": "基因成单",
      "desc": "染色体减半，只带一个基因 D。",
      "role": "与含 d 的生殖细胞结合，子代是 Dd（高茎）。",
      "warn": "生殖细胞里的基因是成单的，不能说「一对基因」。"
    },
    {
      "id": "gamete_d",
      "name": "含 d 的生殖细胞",
      "en": "gamete",
      "only": "基因成单",
      "desc": "染色体减半，只带一个基因 d。",
      "role": "与含 D 的生殖细胞结合，子代同样是 Dd（高茎）。",
      "warn": "d 本身不决定「矮」——只有两个 d 凑在一起才表现矮茎。"
    },
    {
      "id": "f1",
      "name": "子一代（Dd）",
      "en": "F1",
      "only": "显性基因藏住隐性",
      "desc": "一个 D、一个 d，表现为高茎。",
      "role": "隐性基因 d 就藏在这里，没有消失，能继续传下去。",
      "warn": "「子一代全是高茎」不等于「没有矮茎基因」——这是本节最容易错的判断。"
    },
    {
      "id": "f2",
      "name": "子二代",
      "en": "F2",
      "only": "性状分离",
      "desc": "子一代自交的后代，四个个体：DD、Dd、Dd、dd。",
      "role": "表现上 3 高 : 1 矮；基因组成上是 1 : 2 : 1。",
      "warn": "1 : 2 : 1 说的是基因组成，3 : 1 说的是表现，两个比不能混用。"
    },
    {
      "id": "gene",
      "name": "基因",
      "en": "gene",
      "only": "成对存在",
      "desc": "控制性状的 DNA 片段。大写字母表示显性基因，小写表示隐性基因。",
      "role": "显性基因会盖住隐性基因的表现，但盖不住它的传递。",
      "warn": "「显性」说的是表现上盖住对方，不是「更重要」或「更容易遗传」。"
    }
  ]
}
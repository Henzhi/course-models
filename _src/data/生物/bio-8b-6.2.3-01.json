  "steps": [
    {
      "name": "矮茎怎么不见了",
      "say": "孟德尔把纯种高茎豌豆和纯种矮茎豌豆杂交，子一代全部是高茎——矮茎一株都没有。",
      "stats": [
        {
          "v": "100%",
          "label": "子一代都是高茎"
        }
      ],
      "ask": "矮茎的性状消失了吗？如果真消失了，它还有可能再出现吗？",
      "note": "子一代全表现为高茎，说明 <b>高茎对矮茎是显性</b>。但矮茎的基因并没有被「消灭」——它只是<b>没有表现出来</b>。",
      "parts": [
        "parent_tall",
        "parent_short",
        "gamete_D",
        "gamete_d",
        "f1"
      ],
      "routes": [
        "r1",
        "r2",
        "r3",
        "r4"
      ],
      "caption": "纯种高茎 × 纯种矮茎 → 子一代全是高茎"
    },
    {
      "name": "它又回来了",
      "say": "让子一代自交，子二代里矮茎又出现了，而且高茎比矮茎正好接近 3 : 1。",
      "stats": [
        {
          "v": "3 : 1",
          "label": "子二代 高茎 : 矮茎"
        }
      ],
      "ask": "矮茎「消失」了一代又回来了，这说明了什么？",
      "note": "<b>隐性基因不会消失，只是藏在显性基因旁边。</b>子一代是 Dd：D 表现出来了，d 藏着没表现，但它照样能传给下一代。",
      "parts": [
        "f1",
        "f2"
      ],
      "routes": [
        "r5",
        "r6",
        "r7",
        "r8"
      ],
      "caption": "子二代：高茎 : 矮茎 ≈ 3 : 1"
    },
    {
      "name": "大写显性，小写隐性",
      "say": "基因成对存在，一个来自父方、一个来自母方。大写 D 是显性基因，小写 d 是隐性基因。",
      "stats": [
        {
          "v": "D",
          "label": "显性基因 → 高茎"
        },
        {
          "v": "d",
          "label": "隐性基因 → 矮茎"
        }
      ],
      "ask": "为什么 DD 和 Dd 都长成高茎，只有 dd 是矮茎？",
      "note": "<b>只要有一个 D，就表现高茎；两个都是 d，才表现矮茎。</b>这就是「显性」的意思——盖住对方。<br>DD → 高茎 ｜ Dd → 高茎 ｜ dd → 矮茎",
      "parts": [
        "parent_tall",
        "parent_short",
        "f1",
        "f2",
        "gene"
      ],
      "routes": [],
      "caption": "DD、Dd 都是高茎，只有 dd 是矮茎"
    },
    {
      "name": "四种组合从哪来",
      "say": "子一代 Dd 形成生殖细胞时，D 和 d 分开，各进一半的生殖细胞——所以生殖细胞有两种。",
      "ask": "两个 Dd 的生殖细胞随机结合，能凑出几种组合？",
      "table": {
        "head": [
          "",
          "含 D",
          "含 d"
        ],
        "rows": [
          [
            "含 D",
            "DD 高茎",
            "Dd 高茎"
          ],
          [
            "含 d",
            "Dd 高茎",
            "dd 矮茎"
          ]
        ]
      },
      "note": "四种组合是 <b>DD : Dd : Dd : dd</b>，也就是 <b>1 : 2 : 1</b>。看表现：三个高茎、一个矮茎。",
      "parts": [
        "f1",
        "gamete_D",
        "gamete_d",
        "f2"
      ],
      "routes": [
        "r5",
        "r6",
        "r7",
        "r8"
      ],
      "caption": "Dd × Dd → 1 DD : 2 Dd : 1 dd"
    },
    {
      "name": "3 : 1 的来历",
      "say": "基因组成的比是 1 : 2 : 1，但表现出来的比是 3 : 1。",
      "stats": [
        {
          "v": "3 : 1",
          "label": "按性状表现"
        },
        {
          "v": "1 : 2 : 1",
          "label": "按基因组成"
        }
      ],
      "ask": "为什么两个比例不一样？问「高茎几个」和「Dd 几个」，答案一样吗？",
      "note": "<b>DD 和 Dd 长出来都是高茎</b>——基因组成不同，表现相同，所以 1 + 2 = 3 个高茎、1 个矮茎。<br><b>答题先看清问的是「表现」还是「基因组成」。</b>",
      "parts": [
        "f2"
      ],
      "routes": [],
      "caption": "表现 3 : 1；基因组成 1 : 2 : 1"
    }
  ],

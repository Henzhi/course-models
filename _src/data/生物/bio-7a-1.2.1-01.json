    "h": 640
  },
  "hero": {
    "title": "显微镜的使用",
    "goal": "放大倍数 = 目镜 × 物镜；物像移动方向和玻片相反；先低倍、后高倍。",
    "tips": [
      "先点左边显微镜上的部件，把名字和作用认全",
      "再按 ②③④⑤ 的顺序走一遍：对光 → 调焦 → 换倍数 → 物像移动",
      "每换一步，右边「目镜里看到的样子」都会跟着变"
    ]
  },
  "modes": {
    "light": {
      "title": "② 对光",
      "lead": "对光只有一个目标：从目镜里看到一个<b>明亮的白色圆形视野</b>。",
      "note": "光线弱：大光圈 + 凹面镜；光线强：小光圈 + 平面镜。这两组别记反。"
    },
    "focus": {
      "title": "③ 调焦",
      "lead": "先降后升——镜筒<b>下降</b>时眼睛看<b>物镜</b>，<b>上升</b>时眼睛看<b>目镜</b>。",
      "note": "换成高倍镜后只能用细准焦螺旋。用粗准焦容易压碎玻片。"
    },
    "power": {
      "title": "④ 换倍数",
      "lead": "物镜从 10× 换到 40×，视野里的细胞会<b>变大</b>，但看到的<b>变少</b>、亮度<b>变暗</b>。",
      "note": "放大倍数 = 目镜 × 物镜。10× 目镜配 40× 物镜是 400 倍，不是 50 倍。"
    },
    "move": {
      "title": "⑤ 物像移动",
      "lead": "显微镜成的像是倒的，所以<b>物像移动方向和玻片相反</b>。",
      "note": "物像偏左，就往左推玻片——往物像偏的方向推，它才会回到中央。"
    }
  },

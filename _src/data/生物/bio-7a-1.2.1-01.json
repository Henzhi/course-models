  "parts": [
    {
      "id": "eyepiece",
      "name": "目镜",
      "en": "eyepiece",
      "only": "10×",
      "desc": "镜筒上方、靠近眼睛的镜头。这里装的是 10× 目镜，意思是把物镜成的像再放大 10 倍。",
      "warn": "目镜越短，放大倍数越大（和物镜正好相反）。这是最容易记反的一条。"
    },
    {
      "id": "tube",
      "name": "镜筒",
      "en": "body tube",
      "desc": "连接目镜和物镜的一段圆筒，光线从中间通过。",
      "warn": "镜筒本身不放大，它只负责把光路稳定在一条竖直的轴上——所以光路里的几个部件必须在同一条线上。"
    },
    {
      "id": "objective",
      "name": "物镜",
      "en": "objective",
      "only": "10× / 40×",
      "desc": "镜筒下方、靠近标本的镜头。课本实验一般用 10× 和 40× 两个。放大倍数 = 目镜 × 物镜。",
      "warn": "物镜越长，放大倍数越大（和目镜相反）。换高倍镜时镜头会离玻片很近，操作要慢。"
    },
    {
      "id": "stage",
      "name": "载物台",
      "en": "stage",
      "desc": "放玻片标本的平台，中央有一个通光孔，光线从孔里上来穿过标本。",
      "warn": "标本必须正对通光孔，否则视野里一片黑——这是「看不到东西」最常见的原因。"
    },
    {
      "id": "aperture",
      "name": "遮光器（光圈）",
      "en": "diaphragm",
      "desc": "载物台下方可以转动的圆盘，上面有几个大小不同的光圈，用来调节进入的光量。",
      "warn": "光线弱用大光圈，光线强用小光圈。它只调「进多少光」，不负责放大。"
    },
    {
      "id": "mirror",
      "name": "反光镜",
      "en": "mirror",
      "desc": "最下方可以转动的镜子，把外界的光反射上去。一面是平面镜，一面是凹面镜。",
      "warn": "光线强用平面镜，光线弱用凹面镜（凹面镜能聚光）。和光圈是配合使用的两件事。"
    },
    {
      "id": "coarse",
      "name": "粗准焦螺旋",
      "en": "coarse focus knob",
      "desc": "镜臂上的大螺旋，转动时镜筒大幅度升降，用来快速找到物像。",
      "warn": "镜筒下降时眼睛必须看物镜，否则会把物镜压到玻片上。找到物像后就不要再动它。"
    },
    {
      "id": "fine",
      "name": "细准焦螺旋",
      "en": "fine focus knob",
      "desc": "镜臂上的小螺旋，转动时镜筒只微微升降，用来把物像调到最清晰。",
      "warn": "换高倍镜之后只能用细准焦螺旋微调。用粗准焦会直接压碎玻片。"
    },
    {
      "id": "arm",
      "name": "镜臂",
      "en": "arm",
      "desc": "显微镜侧面弯曲的握柄，取放显微镜时一手握镜臂、一手托镜座。",
      "warn": "只能握镜臂，不能提目镜或镜筒——那样容易把镜筒拉松。"
    },
    {
      "id": "base",
      "name": "镜座",
      "en": "base",
      "desc": "显微镜最下面的底座，让镜身稳稳立在桌面上。",
      "warn": "取镜时另一只手要托住镜座，不能只提着上面。"
    }
  ],
